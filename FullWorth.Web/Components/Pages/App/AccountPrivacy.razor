@page "/app/account/privacy"

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@layout AppLayout

@implements IAsyncDisposable

@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<AccountPrivacy> L

<PageTitle>@L["Data & Privacy — FullWorth"]</PageTitle>

<link rel="stylesheet" href="/account-privacy.css" />

<div class="app-page">
    <a class="privacy-back-link fw-back-link" href="/app/account">
        <svg class="bw-sprite" aria-hidden="true">
            <use href="/assets/billwatch-sprites.svg#chevron-left"></use>
        </svg>
        @L["Account"]
    </a>

    <header class="page-heading">
        <div>
            <span class="page-kicker">@L["Data ownership"]</span>
            <h1>@L["Data & privacy"]</h1>
            <p>@L["See what FullWorth keeps, take a portable copy of your data, or permanently remove your account."]</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="@GetMessageClass()">
            @_message
        </div>
    }

    <section class="fw-privacy-hero">
        <div class="fw-privacy-hero-copy">
            <div class="fw-privacy-hero-icon" aria-hidden="true">
                <svg class="bw-sprite">
                    <use href="/assets/billwatch-sprites.svg#shield"></use>
                </svg>
            </div>

            <div>
                <span class="page-kicker">@L["Your data stays under your control"]</span>
                <h2>@L["Financial visibility without financial control."]</h2>
                <p>@L["FullWorth uses your connected financial data to discover recurring bills and explain supported changes. It does not move money or expose protected provider tokens to the client."]</p>
            </div>
        </div>

        <div class="fw-privacy-trust-grid">
            <div>
                <span>@L["Ownership"]</span>
                <strong>@L["User-scoped"]</strong>
                <small>@L["Financial records stay scoped to your account"]</small>
            </div>

            <div>
                <span>@L["Bank credentials"]</span>
                <strong>@L["Not stored"]</strong>
                <small>@L["Plaid handles bank sign-in credentials"]</small>
            </div>

            <div>
                <span>@L["Money movement"]</span>
                <strong>@L["None"]</strong>
                <small>@L["FullWorth does not transfer or pay money"]</small>
            </div>
        </div>
    </section>

    <section class="fw-privacy-control-grid">
        <article class="privacy-management-card fw-privacy-export-card">
            <div class="privacy-management-icon" aria-hidden="true">
                <svg class="bw-sprite">
                    <use href="/assets/billwatch-sprites.svg#document"></use>
                </svg>
            </div>

            <div class="privacy-management-copy">
                <span class="panel-kicker">@L["Portable data"]</span>
                <h2>@L["Export your FullWorth data"]</h2>
                <p>@L["Download a JSON copy of the financial records FullWorth stores for your account."]</p>

                <div class="privacy-facts">
                    <span>✓ @L["Bank connections and masked accounts"]</span>
                    <span>✓ @L["Transactions, Bill Streams and alerts"]</span>
                    <span>✓ @L["Statement metadata and extracted bill history"]</span>
                    <span>✓ @L["No protected Plaid access tokens"]</span>
                    <span>✓ @L["No internal statement storage paths"]</span>
                </div>
            </div>

            <button type="button"
                    class="privacy-primary-button"
                    disabled="@_isExporting"
                    @onclick="ExportDataAsync">
                @(_isExporting ? L["Preparing export…"] : L["Download data"])
            </button>
        </article>

        <article class="privacy-explanation-card fw-privacy-explanation">
            <div>
                <span class="panel-kicker">@L["Why FullWorth keeps data"]</span>
                <h2>@L["Evidence is what makes explanations trustworthy."]</h2>
            </div>

            <p>@L["Transactions are used to discover recurring bills. Statements and extracted line items provide evidence for what changed and why. Alerts surface meaningful findings. FullWorth does not use this data to move money."]</p>
        </article>
    </section>

    <section class="danger-zone fw-privacy-danger">
        <div class="danger-zone-heading">
            <div class="danger-icon">!</div>

            <div>
                <span class="danger-kicker">@L["Danger zone"]</span>
                <h2>@L["Permanently delete FullWorth"]</h2>
            </div>
        </div>

        <p>@L["Account deletion attempts to revoke active bank connections first. If FullWorth cannot safely revoke one of them, deletion stops rather than claiming your account was removed."]</p>

        <div class="delete-consequences">
            <strong>@L["Permanent deletion removes:"]</strong>
            <span>@L["Financial connections and account records"]</span>
            <span>@L["Imported bank transactions"]</span>
            <span>@L["Bill Streams, statements, line items and changes"]</span>
            <span>@L["FullWorth alerts and stored statement files"]</span>
            <span>@L["Subscription entitlements and program memberships"]</span>
            <span>@L["Your FullWorth Identity account"]</span>
        </div>

        @if (!_showDeleteConfirmation)
        {
            <button type="button"
                    class="danger-button"
                    @onclick="ShowDeleteConfirmation">
                @L["Delete account permanently"]
            </button>
        }
        else
        {
            <div class="delete-confirmation">
                <strong>@L["This cannot be undone."]</strong>
                <p>@L["Re-enter your current credentials, then type DELETE to confirm permanent account deletion."]</p>

                <label>
                    <span>@L["Current password"]</span>
                    <InputText class="delete-confirmation-input"
                               type="password"
                               autocomplete="current-password"
                               @bind-Value="_currentPassword" />
                </label>

                <label>
                    <span>@L["Authenticator code (if two-factor authentication is enabled)"]</span>
                    <InputText class="delete-confirmation-input"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               @bind-Value="_twoFactorCode" />
                </label>

                <label>
                    <span>@L["Type DELETE to confirm"]</span>
                    <InputText class="delete-confirmation-input"
                               autocomplete="off"
                               @bind-Value="_deleteConfirmation" />
                </label>

                <div class="delete-confirmation-actions">
                    <button type="button"
                            class="cancel-delete-button"
                            disabled="@_isDeleting"
                            @onclick="CancelDelete">
                        @L["Keep my account"]
                    </button>

                    <button type="button"
                            class="final-delete-button"
                            disabled="@(!CanDelete)"
                            @onclick="DeleteAccountAsync">
                        @(_isDeleting ? L["Deleting securely…"] : L["Delete permanently"])
                    </button>
                </div>
            </div>
        }
    </section>
</div>

@code {
    private IJSObjectReference? _bffModule;
    private IJSObjectReference? _deleteModule;
    private bool _isExporting;
    private bool _isDeleting;
    private bool _showDeleteConfirmation;
    private bool _messageSucceeded;
    private string _deleteConfirmation = string.Empty;
    private string _currentPassword = string.Empty;
    private string _twoFactorCode = string.Empty;
    private string? _message;

    private bool CanDelete =>
        !_isDeleting &&
        !string.IsNullOrWhiteSpace(_currentPassword) &&
        string.Equals(
            _deleteConfirmation,
            "DELETE",
            StringComparison.Ordinal);

    private async Task<IJSObjectReference> GetBffModuleAsync()
    {
        _bffModule ??= await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./js/bff.js");

        return _bffModule;
    }

    private async Task<IJSObjectReference> GetDeleteModuleAsync()
    {
        _deleteModule ??= await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./js/account-delete.js");

        return _deleteModule;
    }

    private async Task ExportDataAsync()
    {
        if (_isExporting || _isDeleting)
        {
            return;
        }

        _isExporting = true;
        _message = null;

        try
        {
            var module = await GetBffModuleAsync();
            await module.InvokeAsync<bool>("downloadAccountExport");

            _messageSucceeded = true;
            _message = L["Your FullWorth data export was prepared securely."];
        }
        catch (JSException)
        {
            _messageSucceeded = false;
            _message = L["FullWorth could not prepare your data export."];
        }
        catch (Exception)
        {
            _messageSucceeded = false;
            _message = L["FullWorth could not prepare your data export."];
        }
        finally
        {
            _isExporting = false;
            StateHasChanged();
        }
    }

    private void ShowDeleteConfirmation()
    {
        if (_isDeleting)
        {
            return;
        }

        _showDeleteConfirmation = true;
        ClearDeletionCredentials();
        _message = null;
    }

    private void CancelDelete()
    {
        if (_isDeleting)
        {
            return;
        }

        _showDeleteConfirmation = false;
        ClearDeletionCredentials();
        _message = null;
    }

    private async Task DeleteAccountAsync()
    {
        if (!CanDelete)
        {
            return;
        }

        _isDeleting = true;
        _message = null;

        try
        {
            var module = await GetDeleteModuleAsync();
            await module.InvokeAsync<bool>(
                "deleteFullWorthAccount",
                _deleteConfirmation,
                _currentPassword,
                _twoFactorCode);

            ClearDeletionCredentials();

            Navigation.NavigateTo(
                "/?accountDeleted=1",
                forceLoad: true);
        }
        catch (JSException ex)
        {
            _messageSucceeded = false;
            _message = GetSafeErrorMessage(ex);
        }
        catch (Exception)
        {
            _messageSucceeded = false;
            _message = L["FullWorth could not safely complete account deletion. Your account was not deleted."];
        }
        finally
        {
            _isDeleting = false;
            StateHasChanged();
        }
    }

    private void ClearDeletionCredentials()
    {
        _deleteConfirmation = string.Empty;
        _currentPassword = string.Empty;
        _twoFactorCode = string.Empty;
    }

    private string GetMessageClass()
    {
        return _messageSucceeded
            ? "privacy-message success"
            : "privacy-message error";
    }

    private string GetSafeErrorMessage(JSException exception)
    {
        var message = exception.Message?
            .Split(
                '\n',
                StringSplitOptions.RemoveEmptyEntries)
            .FirstOrDefault()?
            .Trim();

        if (string.IsNullOrWhiteSpace(message))
        {
            return L["FullWorth could not safely complete this request."];
        }

        if (message.Contains(
                "Current password is incorrect",
                StringComparison.OrdinalIgnoreCase))
        {
            return L["Your current password is incorrect."];
        }

        if (message.Contains(
                "authenticator code",
                StringComparison.OrdinalIgnoreCase))
        {
            return L["Enter a valid current authenticator code to delete this account."];
        }

        if (message.Contains(
                "staff accounts cannot be self-deleted",
                StringComparison.OrdinalIgnoreCase))
        {
            return L["Staff roles must be removed through the authorized admin workflow before this account can be deleted."];
        }

        if (message.Contains(
                "bank connection could not be revoked",
                StringComparison.OrdinalIgnoreCase))
        {
            return L["FullWorth could not safely revoke a connected bank, so your account was not deleted. Try again shortly."];
        }

        if (message.Contains(
                "stored statement",
                StringComparison.OrdinalIgnoreCase))
        {
            return L["FullWorth could not securely remove all stored statement files, so your account was not deleted."];
        }

        return L["FullWorth could not safely complete account deletion. Your account was not deleted."];
    }

    public async ValueTask DisposeAsync()
    {
        if (_bffModule is not null)
        {
            try
            {
                await _bffModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (_deleteModule is not null)
        {
            try
            {
                await _deleteModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
