@page "/app/bills/{BillStreamId:guid}"
@using FullWorth.Core.Formatting

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@layout AppLayout

@implements IAsyncDisposable

@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<BillDetail> L

<PageTitle>@PageTitleText</PageTitle>


<div class="app-page">
    <a class="detail-back fw-back-link"
       href="/app/bills">
        <svg class="bw-sprite" aria-hidden="true">
            <use href="/assets/billwatch-sprites.svg#chevron-left"></use>
        </svg>
        @L["Bills"]
    </a>

    @if (_isLoading)
    {
        <div class="detail-loading">
            <div class="detail-heading-skeleton"></div>

            <div class="detail-grid">
                <div class="detail-panel-skeleton"></div>
                <div class="detail-panel-skeleton"></div>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="app-error-state">
            <div class="state-symbol">!</div>

            <div>
                <h2>@L["We couldn't open this bill"]</h2>
                <p>@_errorMessage</p>
            </div>

            <button type="button"
                    class="secondary-action"
                    @onclick="ReloadAsync">
                @L["Try again"]
            </button>
        </div>
    }
    else if (_detail is not null)
    {
        var transactionDifference = GetTransactionDifference();
        var latestChange = LatestChange;
        var providerLogoUrl =
            FullWorth.Web.Services.ProviderLogoResolver.Resolve(
                _detail.ProviderName);

        <div class="bill-detail-refresh">
            <button type="button" class="secondary-action" disabled="@(_isRefreshing || _isKeeping)" @onclick="ReloadAsync">
                @(_isRefreshing ? L["Refreshing…"] : L["Refresh bill"])
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_refreshError))
        {
            <p class="bill-detail-warning" role="status">@_refreshError</p>
        }

        <section class="fw-detail-hero">
            <div class="fw-detail-provider-pane">
                <div class="detail-provider-avatar">
                    @if (!string.IsNullOrWhiteSpace(providerLogoUrl))
                    {
                        <img src="@providerLogoUrl"
                             alt=""
                             referrerpolicy="no-referrer"
                             decoding="async"
                             class="detail-provider-logo" />
                    }
                    else
                    {
                        @GetProviderInitial(_detail.ProviderName)
                    }
                </div>

                <div class="fw-detail-provider-copy">
                    <span class="page-kicker">
                        @FormatCategory(_detail.Category)
                    </span>

                    <h1>@_detail.ProviderName</h1>

                    <div class="fw-detail-provider-meta">
                        <span class="watching-state">
                            <span></span>
                            @(_detail.IsActive ? L["Watching"] : _detail.Source == "AutomaticDiscovery" ? L["Needs review"] : L["Inactive"])
                        </span>

                        @if (_detail.Statements.Count > 0)
                        {
                            <span>@FormatStatementCount(_detail.Statements.Count)</span>
                        }
                    </div>
                </div>

                <div class="fw-detail-current">
                    <span>@L["Latest posted charge"]</span>
                    <strong>@(_detail.HasTransactionEvidence ? FormatMoney(_detail.CurrentAmount, _detail.CurrencyCode) : L["Amount unavailable"].Value)</strong>

                    @if (CanCompareTransactions)
                    {
                        <small class="@GetDifferenceClass(transactionDifference)">
                            @FormatDifference(transactionDifference, _detail.CurrencyCode)
                            @L["vs. prior average"]
                        </small>
                    }
                    else
                    {
                        <small>@(_detail.PreviousAverage <= 0m ? L["Building comparison history"] : L["Comparison unavailable"])</small>
                    }
                </div>
            </div>

            <div class="fw-detail-evidence-rail">
                <div>
                    <span>@L["Prior transaction average"]</span>
                    <strong>
                        @(_detail.PreviousAverage > 0m
                            ? FormatMoney(_detail.PreviousAverage, _detail.CurrencyCode)
                            : L["Not available"].Value)
                    </strong>
                </div>

                <div>
                    <span>@L["Processed statements"]</span>
                    <strong>@_detail.Statements.Count</strong>
                </div>

                <div>
                    <span>@L["Verified changes"]</span>
                    <strong>@_detail.Changes.Count</strong>
                </div>
            </div>
        </section>

        @if (latestChange is not null)
        {
            <section class="fw-detail-change-story">
                <div class="@GetDetectedChangeClass(latestChange.AmountDifference)">
                <div class="detected-change-main">
                    <div class="change-eyebrow">
                        @L["Most recent verified statement change"]
                    </div>

                    <div class="detected-change-values">
                        <div>
                            <span>@L["Previous"]</span>
                            <strong>@FormatMoney(latestChange.PreviousAmount, latestChange.CurrencyCode)</strong>
                        </div>

                        <span class="detail-arrow">→</span>

                        <div>
                            <span>@L["Current"]</span>
                            <strong>@FormatMoney(latestChange.CurrentAmount, latestChange.CurrencyCode)</strong>
                        </div>
                    </div>
                </div>

                <div class="change-impact-stack">
                    <div>
                        <span>@L["Change"]</span>
                        <strong>@FormatDifference(latestChange.AmountDifference, latestChange.CurrencyCode)</strong>
                    </div>

                    <div>
                        <span>@L["Annual impact"]</span>
                        <strong>@FormatSignedMoney(latestChange.AnnualizedImpact, latestChange.CurrencyCode)</strong>
                    </div>
                </div>
                </div>

                <section class="detail-panel explanation-panel">
                <div class="panel-heading">
                    <div>
                        <span class="panel-kicker">@L["Why it changed"]</span>
                        <h2>@L["FullWorth explanation"]</h2>
                    </div>

                    <span class="@GetConfidenceClass(latestChange.Confidence)">
                        @FormatConfidence(latestChange.Confidence)
                    </span>
                </div>

                <p class="change-description">
                    @GetExplanation(latestChange.Description)
                </p>

                <div class="evidence-metadata">
                    <div>
                        <span>@L["Change type"]</span>
                        <strong>@LocalizeEnumText(latestChange.ChangeType)</strong>
                    </div>

                    <div>
                        <span>@L["Detected"]</span>
                        <strong>
                            <time datetime="@latestChange.DetectedAtUtc.ToString("O")">
                                @FormatTimestampFallback(latestChange.DetectedAtUtc)
                            </time>
                        </strong>
                    </div>

                    <div>
                        <span>@L["Status"]</span>
                        <strong>
                            @(latestChange.IsAcknowledged
                                ? L["Reviewed"]
                                : L["Not reviewed"])
                        </strong>
                    </div>
                </div>
                </section>
            </section>
        }
        else
        {
            <section class="detail-panel no-explanation-panel fw-detail-unknown">
                <div class="no-change-icon">?</div>

                <div>
                    <span class="panel-kicker">@L["Explanation"]</span>
                    <h2>@L["We don't know yet."]</h2>
                    <p>@L["No verified statement comparison has produced a detected change for this bill yet."]</p>
                </div>
            </section>
        }

        <section class="app-panel bill-monitoring-choice" aria-labelledby="monitoring-choice-heading">
            <h2 id="monitoring-choice-heading">@L["Monitoring choice"]</h2>
            @if (!_detail.IsActive || _detail.Source != "Manual")
            {
                <p>@L["Choose to keep this bill monitored even when automatic discovery has insufficient evidence. This does not verify your bank connection, payment timing, or bill amount."]</p>
                <button type="button" class="secondary-action" disabled="@(_isKeeping || _isRefreshing || _confirmationUncertain)" @onclick="KeepMonitoringAsync">
                    @(_isKeeping ? L["Saving…"] : L["Keep monitoring this bill"])
                </button>
            }
            else
            {
                <p>@L["You chose to keep this bill monitored. Automatic discovery will preserve that choice."]</p>
            }
            @if (!string.IsNullOrWhiteSpace(_keepMessage))
            {
                <p role="status">@_keepMessage</p>
            }
        </section>

        <StatementUploadPanel @key="BillStreamId" BillStreamId="@BillStreamId"
                              ProviderName="@_detail.ProviderName"
                              OnProcessed="@HandleStatementProcessedAsync" />

        <div class="detail-grid fw-detail-history-grid">
            <section class="detail-panel">
                <div class="panel-heading">
                    <div>
                        <span class="panel-kicker">@L["Provider documents"]</span>
                        <h2>@L["Statement history"]</h2>
                    </div>

                    <span class="panel-count">@_detail.Statements.Count</span>
                </div>

                @if (_detail.Statements.Count == 0)
                {
                    <div class="detail-empty">
                        <strong>@L["No processed statements yet"]</strong>
                        <span>@L["Transaction history can detect that an amount moved. Statements are what allow FullWorth to explain why."]</span>
                    </div>
                }
                else
                {
                    <div class="statement-list">
                        @foreach (var statement in _detail.Statements)
                        {
                            <article class="statement-row">
                                <div class="statement-date-icon">
                                    <span>@GetMonth(statement.PeriodEnd)</span>
                                    <strong>@GetDay(statement.PeriodEnd)</strong>
                                </div>

                                <div class="statement-info">
                                    <strong>@FormatPeriod(statement.PeriodStart, statement.PeriodEnd)</strong>
                                    <span>@FormatStatementMeta(statement)</span>
                                    @if (statement.SourceUploadId is { } sourceUploadId &&
                                         sourceUploadId != Guid.Empty)
                                    {
                                        <a class="secondary-action"
                                           href="@($"/bff/bill-streams/{BillStreamId:D}/statement-uploads/{sourceUploadId:D}/file")"
                                           target="_blank" rel="noopener noreferrer">
                                            @L["Download original statement"]
                                        </a>
                                    }
                                </div>

                                <div class="statement-amount">
                                    <strong>@FormatMoney(statement.TotalAmount, statement.CurrencyCode)</strong>
                                    <span>@statement.CurrencyCode</span>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="detail-panel">
                <div class="panel-heading">
                    <div>
                        <span class="panel-kicker">@L["History"]</span>
                        <h2>@L["Detected changes"]</h2>
                    </div>

                    <span class="panel-count">@_detail.Changes.Count</span>
                </div>

                @if (_detail.Changes.Count == 0)
                {
                    <div class="detail-empty">
                        <strong>@L["No statement changes yet"]</strong>
                        <span>@L["FullWorth will list verified historical changes here as statement comparisons become available."]</span>
                    </div>
                }
                else
                {
                    <div class="change-history-list">
                        @foreach (var change in StatementChangesByPeriod)
                        {
                            <article class="change-history-row">
                                <div class="@GetHistoryIndicatorClass(change.AmountDifference)"></div>

                                <div class="change-history-copy">
                                    <div class="change-history-heading">
                                        <strong>@LocalizeEnumText(change.ChangeType)</strong>

                                        <time datetime="@change.DetectedAtUtc.ToString("O")">
                                            @FormatTimestampFallback(change.DetectedAtUtc)
                                        </time>
                                    </div>

                                    <p>@GetExplanation(change.Description)</p>

                                    <div class="change-history-meta">
                                        <span>@FormatDifference(change.AmountDifference, change.CurrencyCode)</span>
                                        <span>@FormatSignedMoney(change.AnnualizedImpact, change.CurrencyCode) @L["/ year"]</span>
                                        <span>@FormatConfidence(change.Confidence)</span>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid BillStreamId { get; set; }

    private static readonly System.Globalization.CultureInfo UsCulture =
        System.Globalization.CultureInfo.GetCultureInfo("en-US");

    private IJSObjectReference? _bffModule;
    private BillStreamDetailViewModel? _detail;
    private bool _isLoading = true;
    private string? _errorMessage;
    private bool _isKeeping;
    private string? _keepMessage;
    private Guid? _requestedBillId;
    private long _loadVersion;
    private long _keepVersion;
    private bool _disposed;
    private bool _isRefreshing;
    private bool _confirmationUncertain;
    private string? _refreshError;

    private bool CanCompareTransactions =>
        _detail is { HasTransactionEvidence: true, CurrentAmount: > 0m, PreviousAverage: > 0m } &&
        FinancialAmountFormatter.TryNormalizeCurrency(_detail.CurrencyCode, out _);

    private string PageTitleText =>
        _detail is null
            ? L["Bill — FullWorth"]
            : $"{_detail.ProviderName} — FullWorth";

    // Detection time is an audit timestamp, not the chronology of the provider's billing periods.
    // A historical statement uploaded today must not displace a newer verified billing change.
    private IReadOnlyList<BillChangeViewModel> StatementChangesByPeriod
    {
        get
        {
            if (_detail is null)
            {
                return [];
            }

            var periods = _detail.Statements
                .Where(statement => statement.Id != Guid.Empty && statement.PeriodStart <= statement.PeriodEnd)
                .GroupBy(statement => statement.Id)
                .ToDictionary(group => group.Key, group => group.First());

            return _detail.Changes
                .Where(change => periods.ContainsKey(change.CurrentStatementId))
                .OrderByDescending(change => periods[change.CurrentStatementId].PeriodEnd)
                .ThenByDescending(change => periods[change.CurrentStatementId].PeriodStart)
                .ThenByDescending(change => change.DetectedAtUtc)
                .ThenBy(change => change.Id)
                .ToList();
        }
    }

    private BillChangeViewModel? LatestChange => StatementChangesByPeriod.FirstOrDefault();

    protected override void OnParametersSet()
    {
        if (_requestedBillId != BillStreamId)
        {
            _loadVersion++;
            _keepVersion++;
            _isKeeping = false;
            _isRefreshing = false;
            _confirmationUncertain = false;
            _refreshError = null;
            _detail = null;
            _isLoading = true;
            _errorMessage = null;
            _keepMessage = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _requestedBillId == BillStreamId) return;
        _requestedBillId = BillStreamId;
        await LoadAsync();
        if (!_disposed) StateHasChanged();
    }

    private Task ReloadAsync() => LoadAsync();

    private Task HandleStatementProcessedAsync() => LoadAsync();

    private async Task KeepMonitoringAsync()
    {
        if (_disposed || _detail is null || _isKeeping || _isRefreshing || _confirmationUncertain) return;
        var id = BillStreamId;
        var version = ++_keepVersion;
        _isKeeping = true;
        _keepMessage = null;
        try
        {
            _bffModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/bff.js");
            await _bffModule.InvokeAsync<object?>("confirmBillStream", id.ToString("D"));
            if (_disposed || version != _keepVersion || id != BillStreamId) return;
            // The API's successful response confirms this choice independently of the following read.
            _detail.IsActive = true;
            _detail.Source = "Manual";
            _keepMessage = L["Your monitoring choice was saved."];
            await LoadAsync();
        }
        catch (Exception)
        {
            if (!_disposed && version == _keepVersion && id == BillStreamId)
            {
                // A failed response does not establish whether the server committed the choice.
                _confirmationUncertain = true;
                _keepMessage = L["We could not confirm whether your choice was saved. Refresh this bill before trying again."];
            }
        }
        finally
        {
            if (version == _keepVersion) _isKeeping = false;
        }
    }

    private async Task LoadAsync()
    {
        if (_disposed || _isRefreshing) return;
        var version = ++_loadVersion;
        var id = BillStreamId;
        var hadSnapshot = _detail?.Id == id;
        _isRefreshing = true;
        _isLoading = !hadSnapshot;
        _errorMessage = null;
        _refreshError = null;
        if (id == Guid.Empty)
        {
            _isRefreshing = false;
            _isLoading = false;
            _errorMessage = L["FullWorth could not determine which bill to open."];
            return;
        }

        try
        {
            _bffModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/bff.js");
            var detail = await _bffModule.InvokeAsync<BillStreamDetailViewModel>(
                "getBillStreamDetail", id.ToString("D"));
            if (_disposed || version != _loadVersion || id != BillStreamId) return;
            if (!ValidDetail(detail, id)) throw new InvalidOperationException("Invalid bill detail response.");
            _detail = detail;
            if (_confirmationUncertain) _keepMessage = null;
            _confirmationUncertain = false;
        }
        catch (Exception)
        {
            if (!_disposed && version == _loadVersion && id == BillStreamId)
            {
                if (hadSnapshot)
                    _refreshError = L["We could not refresh this bill. Showing the last loaded evidence; it may be out of date. Try Refresh bill again."];
                else
                    _errorMessage = L["FullWorth could not load this bill from the secure API."];
            }
        }
        finally
        {
            if (version == _loadVersion)
            {
                _isRefreshing = false;
                _isLoading = false;
            }
        }
    }

    private static bool ValidDetail(BillStreamDetailViewModel? detail, Guid id) =>
        detail?.Id == id && detail.Statements is not null && detail.Changes is not null &&
        detail.Statements.All(item => item is not null && item.Id != Guid.Empty) &&
        detail.Changes.All(item => item is not null && item.Id != Guid.Empty) &&
        detail.Statements.Select(item => item.Id).Distinct().Count() == detail.Statements.Count &&
        detail.Changes.Select(item => item.Id).Distinct().Count() == detail.Changes.Count;

    private decimal GetTransactionDifference()
    {
        if (!CanCompareTransactions)
        {
            return 0m;
        }

        return _detail!.CurrentAmount - _detail.PreviousAverage;
    }

    private string FormatMoney(decimal amount, string? currencyCode) =>
        FinancialAmountFormatter.FormatOrUnspecified(amount, currencyCode, L["Currency unavailable"].Value);

    private string FormatSignedMoney(decimal amount, string? currencyCode)
    {
        if (amount > 0m)
        {
            return $"+{FormatMoney(amount, currencyCode)}";
        }

        if (amount < 0m)
        {
            return $"-{FormatMoney(Math.Abs(amount), currencyCode)}";
        }

        return FormatMoney(0m, currencyCode);
    }

    private string FormatDifference(decimal difference, string? currencyCode) =>
        FormatSignedMoney(difference, currencyCode);

    private static string GetDifferenceClass(decimal difference) =>
        difference > 0m
            ? "detail-amount-difference increase"
            : difference < 0m
                ? "detail-amount-difference decrease"
                : "detail-amount-difference steady";

    private static string GetDetectedChangeClass(decimal difference) =>
        difference > 0m
            ? "detected-change-card increase"
            : difference < 0m
                ? "detected-change-card decrease"
                : "detected-change-card steady";

    private static string GetHistoryIndicatorClass(decimal difference) =>
        difference > 0m
            ? "change-history-indicator increase"
            : difference < 0m
                ? "change-history-indicator decrease"
                : "change-history-indicator steady";

    private static string GetProviderInitial(string providerName)
    {
        if (string.IsNullOrWhiteSpace(providerName))
        {
            return "?";
        }

        return char.ToUpperInvariant(providerName.Trim()[0]).ToString();
    }

    private string FormatCategory(string? category)
    {
        if (string.IsNullOrWhiteSpace(category) ||
            string.Equals(category, "Unknown", StringComparison.OrdinalIgnoreCase))
        {
            return L["Recurring bill"];
        }

        return LocalizeEnumText(category);
    }

    private string GetExplanation(string? description)
    {
        if (string.IsNullOrWhiteSpace(description))
        {
            return L["FullWorth detected a change, but the available evidence does not explain the cause confidently."];
        }

        // Evidence text is preserved verbatim. Localization must not alter the facts FullWorth extracted.
        return description.Trim();
    }

    private string FormatConfidence(string? confidence)
    {
        if (string.IsNullOrWhiteSpace(confidence))
        {
            return L["Unknown confidence"];
        }

        return LocalizeEnumText(confidence);
    }

    private static string GetConfidenceClass(string? confidence)
    {
        if (string.Equals(confidence, "Confirmed", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(confidence, "High", StringComparison.OrdinalIgnoreCase))
        {
            return "confidence-pill confirmed";
        }

        if (string.Equals(confidence, "Unknown", StringComparison.OrdinalIgnoreCase))
        {
            return "confidence-pill unknown";
        }

        return "confidence-pill inferred";
    }

    private static string FormatTimestampFallback(DateTimeOffset value) =>
        value.ToUniversalTime().ToString("MM/dd/yyyy HH:mm 'UTC'", UsCulture);

    private static string FormatPeriod(DateOnly start, DateOnly end)
    {
        var culture = System.Globalization.CultureInfo.CurrentUICulture;

        if (start.Year == end.Year && start.Month == end.Month)
        {
            return $"{start.ToString("MMM d", culture)} – {end.ToString("d, yyyy", culture)}";
        }

        return $"{start.ToString("MMM d", culture)} – {end.ToString("MMM d, yyyy", culture)}";
    }

    private string FormatStatementMeta(BillStatementViewModel statement)
    {
        var culture = System.Globalization.CultureInfo.CurrentUICulture;
        var parts = new List<string>();

        if (statement.StatementDate is not null)
        {
            parts.Add($"{L["Statement"]} {statement.StatementDate.Value.ToString("MMM d, yyyy", culture)}");
        }

        if (statement.DueDate is not null)
        {
            parts.Add($"{L["Due"]} {statement.DueDate.Value.ToString("MMM d, yyyy", culture)}");
        }

        return parts.Count == 0
            ? L["Statement period"]
            : string.Join(" · ", parts);
    }

    private static string GetMonth(DateOnly date) =>
        date.ToString("MMM", System.Globalization.CultureInfo.CurrentUICulture)
            .ToUpper(System.Globalization.CultureInfo.CurrentUICulture);

    private static string GetDay(DateOnly date) =>
        date.Day.ToString(System.Globalization.CultureInfo.CurrentUICulture);

    private string LocalizeEnumText(string? value)
    {
        var humanized = HumanizeEnumText(value);
        return L[humanized];
    }

    private static string HumanizeEnumText(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Unknown";
        }

        var builder = new System.Text.StringBuilder();

        for (var index = 0; index < value.Length; index++)
        {
            var character = value[index];

            if (index > 0 &&
                char.IsUpper(character) &&
                !char.IsWhiteSpace(value[index - 1]))
            {
                builder.Append(' ');
            }

            builder.Append(character);
        }

        return builder.ToString().Trim();
    }

    private string FormatStatementCount(int count) =>
        count == 1
            ? L["1 statement"]
            : L["{0} statements", count];

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _loadVersion++;
        _keepVersion++;
        _detail = null;
        _keepMessage = null;
        if (_bffModule is null)
        {
            return;
        }

        try
        {
            await _bffModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public sealed class BillStreamDetailViewModel
    {
        public Guid Id { get; set; }
        public string ProviderName { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public bool IsActive { get; set; }
        public string? CurrencyCode { get; set; }
        public string Source { get; set; } = "Unknown";
        public bool HasTransactionEvidence { get; set; }
        public bool HasMonthlyCadenceEvidence { get; set; }
        public decimal CurrentAmount { get; set; }
        public decimal PreviousAverage { get; set; }
        public List<BillStatementViewModel> Statements { get; set; } = [];
        public List<BillChangeViewModel> Changes { get; set; } = [];
    }

    public sealed class BillStatementViewModel
    {
        public Guid Id { get; set; }
        public DateOnly PeriodStart { get; set; }
        public DateOnly PeriodEnd { get; set; }
        public DateOnly? StatementDate { get; set; }
        public DateOnly? DueDate { get; set; }
        public decimal TotalAmount { get; set; }
        public string? CurrencyCode { get; set; }
        public Guid? SourceUploadId { get; set; }
    }

    public sealed class BillChangeViewModel
    {
        public Guid Id { get; set; }
        public Guid? PreviousStatementId { get; set; }
        public Guid CurrentStatementId { get; set; }
        public string ChangeType { get; set; } = string.Empty;
        public string Confidence { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal PreviousAmount { get; set; }
        public decimal CurrentAmount { get; set; }
        public decimal AmountDifference { get; set; }
        public string? CurrencyCode { get; set; }
        public decimal AnnualizedImpact { get; set; }
        public bool IsAcknowledged { get; set; }
        public DateTimeOffset DetectedAtUtc { get; set; }
    }
}
