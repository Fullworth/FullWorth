@page "/app/activity"

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using FullWorth.Web.Presentation

@layout AppLayout

@implements IAsyncDisposable

@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<Activity> L

<PageTitle>@L["Activity — FullWorth"]</PageTitle>


<div class="app-page">
    <header class="page-heading">
        <div>
            <span class="page-kicker">
                @L["Financial signal feed"]
            </span>

            <h1>
                @L["Activity"]
            </h1>

            <p>
                @L["Important bill changes, payment reminders, payday guidance, newly discovered recurring bills, and connection issues that may need your attention."]
            </p>
        </div>

        @if (!_isLoading &&
             string.IsNullOrWhiteSpace(
                 _errorMessage))
        {
            <button type="button"
                    class="activity-refresh-button"
                    disabled="@(_isMutating || _isRefreshing)"
                    aria-busy="@(_isRefreshing ? "true" : "false")"
                    @onclick="ReloadAsync">

                <svg class="bw-sprite" aria-hidden="true">
                    <use href="/assets/billwatch-sprites.svg#refresh"></use>
                </svg>

                @(_isRefreshing ? L["Refreshing…"] : L["Refresh"])
            </button>
        }
    </header>

    @if (_isLoading)
    {
        <div class="activity-summary-skeleton">
            @for (var index = 0;
                  index < 3;
                  index++)
            {
                <div></div>
            }
        </div>

        <div class="alert-loading-list">
            @for (var index = 0;
                  index < 5;
                  index++)
            {
                <div class="alert-loading-row"></div>
            }
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(
        _errorMessage))
    {
        <div class="app-error-state">
            <div class="state-symbol">
                !
            </div>

            <div>
                <h2>
                    @L["We couldn't load your activity"]
                </h2>

                <p>
                    @_errorMessage
                </p>
            </div>

            <button type="button"
                    class="secondary-action"
                    @onclick="ReloadAsync">
                @L["Try again"]
            </button>
        </div>
    }
    else
    {
        var unreadCount =
            _alerts.Count(
                alert =>
                    !alert.IsRead);

        var needsAttentionCount =
            _alerts.Count(
                alert =>
                    IsAttentionSeverity(
                        alert.Severity));

        var connectionIssuesCount =
            _alerts.Count(
                alert => ActivityFeedPresentation.IsConnectionIssue(alert.AlertType));

        var filteredAlerts =
            FilteredAlerts;

        @if (!string.IsNullOrWhiteSpace(_refreshError))
        {
            <div class="activity-action-error" role="alert">@_refreshError</div>
        }
        <p class="activity-scope-note">@L["Showing up to 100 recent active alerts, not your entire history. Counts describe loaded alerts only; no alerts does not prove that monitoring is complete."]</p>

        <section class="@GetActivityPulseClass(needsAttentionCount)"
                 aria-label="@L["Activity summary"]">
            <div class="fw-activity-pulse-copy">
                <span class="fw-activity-eyebrow">
                    @(needsAttentionCount > 0
                        ? L["Needs your attention"]
                        : L["No attention alerts loaded"])
                </span>

                <strong class="fw-activity-number">
                    @needsAttentionCount
                </strong>

                <span class="fw-activity-number-label">
                    @(needsAttentionCount == 1
                        ? L["active alert worth reviewing"]
                        : L["active alerts worth reviewing"])
                </span>

                <p>
                    @if (needsAttentionCount > 0)
                    {
                        @L["FullWorth found financial activity that may need review. Open an item to see the evidence and next step."]
                    }
                    else
                    {
                        @L["No warning or critical alerts appear in the loaded feed. Check bank connections if expected activity is missing."]
                    }
                </p>
            </div>

            <div class="fw-activity-pulse-stats">
                <div>
                    <span>@L["Unread"]</span>
                    <strong>@unreadCount</strong>
                </div>

                <div>
                    <span>@L["Recent activity"]</span>
                    <strong>@_alerts.Count</strong>
                </div>

                <div>
                    <span>@L["View limit"]</span>
                    <strong>100</strong>
                    <small>@L["recent active alerts"]</small>
                </div>
            </div>
        </section>

        @if (connectionIssuesCount > 0)
        {
            <aside class="activity-connection-guidance" aria-label="@L["Connection alerts"]">
                <div>
                    <strong>@L["Check your bank connections"]</strong>
                    <p>@L["{0} loaded alerts describe connection problems. Reading or dismissing an alert does not repair a bank or prove that transactions are current.", connectionIssuesCount]</p>
                </div>
                <a href="/app/account">@L["Review bank connections"] <span aria-hidden="true">→</span></a>
            </aside>
        }

        <section class="fw-activity-feed">
            <div class="fw-activity-feed-head">
                <div>
                    <span class="panel-kicker">@L["Activity"]</span>
                    <h2>@L["Your financial feed"]</h2>
                </div>

                <div class="activity-filters" role="group" aria-label="@L["Filter activity"]">
                    <button type="button"
                            class="@GetFilterClass(ActivityFilter.All)"
                            aria-pressed="@(_filter == ActivityFilter.All)"
                            @onclick="() => SetFilter(ActivityFilter.All)">
                        @L["All"]
                        <span>@_alerts.Count</span>
                    </button>

                    <button type="button"
                            class="@GetFilterClass(ActivityFilter.Unread)"
                            aria-pressed="@(_filter == ActivityFilter.Unread)"
                            @onclick="() => SetFilter(ActivityFilter.Unread)">
                        @L["Unread"]
                        <span>@unreadCount</span>
                    </button>

                    <button type="button"
                            class="@GetFilterClass(ActivityFilter.Attention)"
                            aria-pressed="@(_filter == ActivityFilter.Attention)"
                            @onclick="() => SetFilter(ActivityFilter.Attention)">
                        @L["Attention"]
                        <span>@needsAttentionCount</span>
                    </button>

                    <button type="button"
                            class="@GetFilterClass(ActivityFilter.ConnectionIssues)"
                            aria-pressed="@(_filter == ActivityFilter.ConnectionIssues)"
                            @onclick="() => SetFilter(ActivityFilter.ConnectionIssues)">
                        @L["Connection issues"]
                        <span>@connectionIssuesCount</span>
                    </button>
                </div>
            </div>

            <p class="activity-scope-note">@L["Opening evidence does not mark an alert as read. Use Mark read when you have reviewed it; dismissing an alert does not fix a bank connection or bill."]</p>

            <div class="activity-search-tools">
                <label for="activity-search">@L["Search activity"]</label>
                <input id="activity-search" type="search" maxlength="200"
                       placeholder="@L["Search titles and messages"]" autocomplete="off"
                       @bind="_searchText" @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(_searchText) || _filter != ActivityFilter.All)
                {
                    <button type="button" class="secondary-action" @onclick="ResetFilters">@L["Clear filters"]</button>
                }
                <span role="status" aria-live="polite" aria-atomic="true">
                    @L["Showing {0} of {1} loaded alerts", filteredAlerts.Count, _alerts.Count]
                </span>
            </div>

            @if (!string.IsNullOrWhiteSpace(
                _actionError))
            {
                <div class="activity-action-error" role="alert">
                    @_actionError
                </div>
            }

            @if (_alerts.Count == 0)
            {
                <section class="alerts-empty">
                    <div class="alerts-empty-icon">
                        <svg class="bw-sprite" aria-hidden="true">
                            <use href="/assets/billwatch-sprites.svg#check"></use>
                        </svg>
                    </div>

                    <span class="page-kicker">
                        @L["No alerts loaded"]
                    </span>

                    <h2>
                        @L["No recent active alerts loaded."]
                    </h2>

                    <p>
                        @L["FullWorth shows alerts when evidence supports them. This is not a guarantee that every bill or bank connection is being monitored."]
                        <a href="/app/account">@L["Check bank connections"]</a>
                    </p>
                </section>
            }
            else if (filteredAlerts.Count == 0)
            {
                <section class="alerts-filter-empty">
                    <strong>
                        @L["Nothing in this view."]
                    </strong>

                    <span>
                        @L["Change the search or filter, or clear filters to return to the loaded feed."]
                    </span>
                </section>
            }
            else
            {
                <section class="alert-list">
                    @foreach (var alert
                        in filteredAlerts)
                    {
                        <AlertCard @key="alert.Id"
                                   Alert="@ToCardViewModel(alert)"
                                   IsBusy="@(_isMutating || _isRefreshing)"
                                   CanReview="@CanReview(alert)"
                                   OnMarkRead="@HandleMarkReadAsync"
                                   OnDismiss="@HandleDismissAsync"
                                   ReviewHref="@GetReviewDestination(alert)" />
                    }
                </section>
            }
        </section>
    }
</div>

@code {
    private IJSObjectReference?
        _bffModule;

    private List<BillAlertViewModel>
        _alerts = [];

    private bool _isLoading =
        true;

    private bool _isMutating;
    private bool _hasLoaded;
    private bool _isRefreshing;
    private string? _refreshError;
    private string _searchText = string.Empty;


    private string? _errorMessage;

    private string? _actionError;

    private ActivityFilter _filter =
        ActivityFilter.All;

    private IReadOnlyList<BillAlertViewModel> FilteredAlerts =>
        ActivityFeedPresentation.Filter(_alerts, _filter, _searchText);

    private void ResetFilters()
    {
        _filter = ActivityFilter.All;
        _searchText = string.Empty;
    }

    protected override async Task
        OnAfterRenderAsync(
            bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadAsync();

        StateHasChanged();
    }

    private async Task<
        IJSObjectReference>
        GetBffModuleAsync()
    {
        _bffModule ??=
            await JS.InvokeAsync<
                IJSObjectReference>(
                "import",
                "./js/bff.js");

        return _bffModule;
    }

    private async Task ReloadAsync()
    {
        if (_isMutating || _isRefreshing || _isLoading)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = !_hasLoaded;
        _isRefreshing = _hasLoaded;
        _errorMessage = null;
        _refreshError = null;
        _actionError = null;

        try
        {
            var module =
                await GetBffModuleAsync();

            var result =
                await module
                    .InvokeAsync<
                        BillAlertViewModel[]>(
                        "getAlerts",
                        false,
                        false,
                        100);

            // Reject invalid responses without turning an existing feed into a false empty state.
            if (!IsValidActivitySnapshot(result))
                throw new InvalidOperationException("Invalid activity response.");

            _alerts = result
                .Where(alert => !alert.IsDismissed)
                .OrderByDescending(alert => alert.CreatedAtUtc)
                .ThenBy(alert => alert.Id)
                .ToList();
            _hasLoaded = true;
        }
        catch (Exception)
        {
            if (_hasLoaded)
                _refreshError = L["Refresh failed. Previously loaded alerts are still shown; they may be out of date. Try refreshing again."].Value;
            else
                _errorMessage = L["FullWorth could not load your activity. Try again."].Value;
        }
        finally
        {
            _isLoading = false;
            _isRefreshing = false;
        }
    }

    // A successful HTTP response is not proof that returned financial alerts are usable.
    // Reject malformed identity/evidence before replacing the last verified activity feed.
    private static bool IsValidActivitySnapshot(IReadOnlyList<BillAlertViewModel>? alerts)
    {
        if (alerts is null || alerts.Count > 100 ||
            alerts.Any(alert =>
                alert is null ||
                alert.Id == Guid.Empty ||
                string.IsNullOrWhiteSpace(alert.Title) ||
                string.IsNullOrWhiteSpace(alert.Message) ||
                string.IsNullOrWhiteSpace(alert.AlertType) ||
                string.IsNullOrWhiteSpace(alert.Severity) ||
                alert.CreatedAtUtc == default ||
                alert.UpdatedAtUtc == default))
        {
            return false;
        }

        return alerts.Select(alert => alert.Id).Distinct().Count() == alerts.Count;
    }

    private void SetFilter(
        ActivityFilter filter)
    {
        _filter =
            filter;
    }

    private string GetFilterClass(
        ActivityFilter filter)
    {
        return _filter ==
                filter
            ? "activity-filter active"
            : "activity-filter";
    }

    private static string GetActivityPulseClass(
        int needsAttentionCount)
    {
        return needsAttentionCount > 0
            ? "fw-activity-pulse has-attention"
            : "fw-activity-pulse is-calm";
    }

    private static bool IsAttentionSeverity(string? severity) =>
        ActivityFeedPresentation.IsAttentionSeverity(severity);

    private static bool CanReview(BillAlertViewModel alert) =>
        GetReviewDestination(alert) is not null;

    private async Task HandleMarkReadAsync(
        Guid alertId)
    {
        var alert =
            FindAlert(
                alertId);

        if (alert is null ||
            alert.IsRead)
        {
            return;
        }

        await RunAlertMutationAsync(
            alertId,
            async module =>
            {
                await module
                    .InvokeAsync<object?>(
                        "markAlertRead",
                        alertId.ToString(
                            "D"));

                alert.IsRead =
                    true;
            });
    }

    private async Task HandleDismissAsync(
        Guid alertId)
    {
        var alert =
            FindAlert(
                alertId);

        if (alert is null)
        {
            return;
        }

        await RunAlertMutationAsync(
            alertId,
            async module =>
            {
                await module
                    .InvokeAsync<object?>(
                        "dismissAlert",
                        alertId.ToString(
                            "D"));

                _alerts.Remove(
                    alert);
            });
    }

    private async Task<bool>
        RunAlertMutationAsync(
            Guid alertId,
            Func<IJSObjectReference, Task>
                mutation)
    {
        if (_isMutating || _isRefreshing || _isLoading)
        {
            return false;
        }

        _isMutating =
            true;

        _actionError =
            null;

        try
        {
            var module =
                await GetBffModuleAsync();

            await mutation(
                module);

            return true;
        }
        catch (JSException)
        {
            _actionError =
                L["FullWorth could not update that alert. Try again."].Value;
        }
        catch (Exception)
        {
            _actionError =
                L["FullWorth could not update that alert. Try again."].Value;
        }
        finally
        {
            _isMutating =
                false;

            StateHasChanged();
        }

        return false;
    }

    private BillAlertViewModel?
        FindAlert(
            Guid alertId)
    {
        return _alerts
            .FirstOrDefault(
                alert =>
                    alert.Id ==
                        alertId);
    }

    private static string? GetReviewDestination(BillAlertViewModel alert) =>
        ActivityFeedPresentation.GetReviewDestination(alert.BillStreamId, alert.AlertType);

    private static
        AlertCard.AlertCardViewModel
        ToCardViewModel(
            BillAlertViewModel alert)
    {
        return new
            AlertCard.AlertCardViewModel
        {
            Id =
                    alert.Id,

            BillStreamId =
                    alert.BillStreamId,

            BillChangeId =
                    alert.BillChangeId,

            AlertType =
                    alert.AlertType,

            Severity =
                    alert.Severity,

            Title =
                    alert.Title,

            Message =
                    alert.Message,

            IsRead =
                    alert.IsRead,

            IsDismissed =
                    alert.IsDismissed,

            CreatedAtUtc =
                    alert.CreatedAtUtc,

            UpdatedAtUtc =
                    alert.UpdatedAtUtc
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (_bffModule is null)
        {
            return;
        }

        try
        {
            await _bffModule
                .DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public enum ActivityFilter
    {
        All,
        Unread,
        Attention,
        ConnectionIssues
    }

    public sealed class BillAlertViewModel
    {
        public Guid Id
        {
            get;
            set;
        }

        public Guid? BillStreamId
        {
            get;
            set;
        }

        public Guid? BillChangeId
        {
            get;
            set;
        }

        public string AlertType
        {
            get;
            set;
        } = string.Empty;

        public string Severity
        {
            get;
            set;
        } = "Info";

        public string Title
        {
            get;
            set;
        } = string.Empty;

        public string Message
        {
            get;
            set;
        } = string.Empty;

        public bool IsRead
        {
            get;
            set;
        }

        public bool IsDismissed
        {
            get;
            set;
        }

        public DateTimeOffset CreatedAtUtc
        {
            get;
            set;
        }

        public DateTimeOffset UpdatedAtUtc
        {
            get;
            set;
        }
    }
}
