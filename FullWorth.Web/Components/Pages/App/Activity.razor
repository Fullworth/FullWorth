@page "/app/activity"

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@layout AppLayout

@implements IAsyncDisposable

@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<Activity> L

<PageTitle>@L["Activity — FullWorth"]</PageTitle>


<div class="app-page">
    <header class="page-heading">
        <div>
            <span class="page-kicker">
                @L["Financial signal feed"]
            </span>

            <h1>
                @L["Activity"]
            </h1>

            <p>
                @L["Important bill changes, payment reminders, newly discovered recurring bills, and connection issues that may need your attention."]
            </p>
        </div>

        @if (!_isLoading &&
             string.IsNullOrWhiteSpace(
                 _errorMessage))
        {
            <button type="button"
                    class="activity-refresh-button"
                    disabled="@_isMutating"
                    @onclick="ReloadAsync">

                <svg class="bw-sprite" aria-hidden="true">
                    <use href="/assets/billwatch-sprites.svg#refresh"></use>
                </svg>

                @L["Refresh"]
            </button>
        }
    </header>

    @if (_isLoading)
    {
        <div class="activity-summary-skeleton">
            @for (var index = 0;
                  index < 3;
                  index++)
            {
                <div></div>
            }
        </div>

        <div class="alert-loading-list">
            @for (var index = 0;
                  index < 5;
                  index++)
            {
                <div class="alert-loading-row"></div>
            }
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(
        _errorMessage))
    {
        <div class="app-error-state">
            <div class="state-symbol">
                !
            </div>

            <div>
                <h2>
                    @L["We couldn't load your activity"]
                </h2>

                <p>
                    @_errorMessage
                </p>
            </div>

            <button type="button"
                    class="secondary-action"
                    @onclick="ReloadAsync">
                @L["Try again"]
            </button>
        </div>
    }
    else
    {
        var unreadCount =
            _alerts.Count(
                alert =>
                    !alert.IsRead);

        var needsAttentionCount =
            _alerts.Count(
                alert =>
                    IsAttentionSeverity(
                        alert.Severity));

        var filteredAlerts =
            FilteredAlerts;

        <section class="@GetActivityPulseClass(needsAttentionCount)"
                 aria-label="@L["Activity summary"]">
            <div class="fw-activity-pulse-copy">
                <span class="fw-activity-eyebrow">
                    @(needsAttentionCount > 0
                        ? L["Needs your attention"]
                        : L["All quiet"])
                </span>

                <strong class="fw-activity-number">
                    @needsAttentionCount
                </strong>

                <span class="fw-activity-number-label">
                    @(needsAttentionCount == 1
                        ? L["active alert worth reviewing"]
                        : L["active alerts worth reviewing"])
                </span>

                <p>
                    @if (needsAttentionCount > 0)
                    {
                        @L["FullWorth found financial activity that may need review. Open an item to see the evidence and next step."]
                    }
                    else
                    {
                        @L["There are no warning or critical alerts waiting for you right now."]
                    }
                </p>
            </div>

            <div class="fw-activity-pulse-stats">
                <div>
                    <span>@L["Unread"]</span>
                    <strong>@unreadCount</strong>
                </div>

                <div>
                    <span>@L["Recent activity"]</span>
                    <strong>@_alerts.Count</strong>
                </div>

                <div>
                    <span>@L["Retention"]</span>
                    <strong>100</strong>
                    <small>@L["latest active alerts"]</small>
                </div>
            </div>
        </section>

        <section class="fw-activity-feed">
            <div class="fw-activity-feed-head">
                <div>
                    <span class="panel-kicker">@L["Activity"]</span>
                    <h2>@L["Your financial feed"]</h2>
                </div>

                <div class="activity-filters">
                    <button type="button"
                            class="@GetFilterClass(ActivityFilter.All)"
                            aria-pressed="@(_filter == ActivityFilter.All)"
                            @onclick="() => SetFilter(ActivityFilter.All)">
                        @L["All"]
                        <span>@_alerts.Count</span>
                    </button>

                    <button type="button"
                            class="@GetFilterClass(ActivityFilter.Unread)"
                            aria-pressed="@(_filter == ActivityFilter.Unread)"
                            @onclick="() => SetFilter(ActivityFilter.Unread)">
                        @L["Unread"]
                        <span>@unreadCount</span>
                    </button>

                    <button type="button"
                            class="@GetFilterClass(ActivityFilter.Attention)"
                            aria-pressed="@(_filter == ActivityFilter.Attention)"
                            @onclick="() => SetFilter(ActivityFilter.Attention)">
                        @L["Attention"]
                        <span>@needsAttentionCount</span>
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(
                _actionError))
            {
                <div class="activity-action-error">
                    @_actionError
                </div>
            }

            @if (_alerts.Count == 0)
            {
                <section class="alerts-empty">
                    <div class="alerts-empty-icon">
                        <svg class="bw-sprite" aria-hidden="true">
                            <use href="/assets/billwatch-sprites.svg#check"></use>
                        </svg>
                    </div>

                    <span class="page-kicker">
                        @L["All quiet"]
                    </span>

                    <h2>
                        @L["No FullWorth alerts yet."]
                    </h2>

                    <p>
                        @L["FullWorth will surface meaningful recurring-bill changes and account issues here when evidence supports them."]
                    </p>
                </section>
            }
            else if (filteredAlerts.Count == 0)
            {
                <section class="alerts-filter-empty">
                    <strong>
                        @L["Nothing in this view."]
                    </strong>

                    <span>
                        @L["Try another activity filter."]
                    </span>
                </section>
            }
            else
            {
                <section class="alert-list">
                    @foreach (var alert
                        in filteredAlerts)
                    {
                        <AlertCard @key="alert.Id"
                                   Alert="@ToCardViewModel(alert)"
                                   IsBusy="@IsAlertBusy(alert.Id)"
                                   CanReview="@CanReview(alert)"
                                   OnMarkRead="@HandleMarkReadAsync"
                                   OnDismiss="@HandleDismissAsync"
                                   OnReview="@HandleReviewAsync" />
                    }
                </section>
            }
        </section>
    }
</div>

@code {
    private IJSObjectReference?
        _bffModule;

    private List<BillAlertViewModel>
        _alerts = [];

    private bool _isLoading =
        true;

    private bool _isMutating;

    private Guid? _busyAlertId;

    private string? _errorMessage;

    private string? _actionError;

    private ActivityFilter _filter =
        ActivityFilter.All;

    private IReadOnlyList<
        BillAlertViewModel>
        FilteredAlerts =>
            _alerts
                .Where(
                    alert =>
                        _filter switch
                        {
                            ActivityFilter.Unread =>
                                !alert.IsRead,

                            ActivityFilter.Attention =>
                                IsAttentionSeverity(
                                    alert.Severity),

                            _ =>
                                true
                        })
                .ToList();

    protected override async Task
        OnAfterRenderAsync(
            bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadAsync();

        StateHasChanged();
    }

    private async Task<
        IJSObjectReference>
        GetBffModuleAsync()
    {
        _bffModule ??=
            await JS.InvokeAsync<
                IJSObjectReference>(
                "import",
                "./js/bff.js");

        return _bffModule;
    }

    private async Task ReloadAsync()
    {
        if (_isMutating)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading =
            true;

        _errorMessage =
            null;

        _actionError =
            null;

        try
        {
            var module =
                await GetBffModuleAsync();

            var result =
                await module
                    .InvokeAsync<
                        BillAlertViewModel[]>(
                        "getAlerts",
                        false,
                        false,
                        100);

            _alerts =
                result?
                    .Where(
                        alert =>
                            !alert.IsDismissed)
                    .OrderByDescending(
                        alert =>
                            alert.CreatedAtUtc)
                    .ToList()
                ?? [];
        }
        catch (JSException)
        {
            _errorMessage =
                L["FullWorth could not reach the secure API."].Value;
        }
        catch (Exception)
        {
            _errorMessage =
                L["Something went wrong while loading FullWorth activity."].Value;
        }
        finally
        {
            _isLoading =
                false;
        }
    }

    private void SetFilter(
        ActivityFilter filter)
    {
        _filter =
            filter;
    }

    private string GetFilterClass(
        ActivityFilter filter)
    {
        return _filter ==
                filter
            ? "activity-filter active"
            : "activity-filter";
    }

    private static string GetActivityPulseClass(
        int needsAttentionCount)
    {
        return needsAttentionCount > 0
            ? "fw-activity-pulse has-attention"
            : "fw-activity-pulse is-calm";
    }

    private bool IsAlertBusy(
        Guid alertId)
    {
        return _isMutating &&
            _busyAlertId ==
                alertId;
    }

    private static bool
        IsAttentionSeverity(
            string? severity)
    {
        return string.Equals(
                severity,
                "Warning",
                StringComparison.OrdinalIgnoreCase) ||
            string.Equals(
                severity,
                "Critical",
                StringComparison.OrdinalIgnoreCase);
    }

    private static bool CanReview(
        BillAlertViewModel alert)
    {
        if (alert.BillStreamId
            .HasValue)
        {
            return true;
        }

        return string.Equals(
            alert.AlertType,
            "ConnectionIssue",
            StringComparison.OrdinalIgnoreCase);
    }

    private async Task HandleMarkReadAsync(
        Guid alertId)
    {
        var alert =
            FindAlert(
                alertId);

        if (alert is null ||
            alert.IsRead)
        {
            return;
        }

        await RunAlertMutationAsync(
            alertId,
            async module =>
            {
                await module
                    .InvokeAsync<object?>(
                        "markAlertRead",
                        alertId.ToString(
                            "D"));

                alert.IsRead =
                    true;
            });
    }

    private async Task HandleDismissAsync(
        Guid alertId)
    {
        var alert =
            FindAlert(
                alertId);

        if (alert is null)
        {
            return;
        }

        await RunAlertMutationAsync(
            alertId,
            async module =>
            {
                await module
                    .InvokeAsync<object?>(
                        "dismissAlert",
                        alertId.ToString(
                            "D"));

                _alerts.Remove(
                    alert);
            });
    }

    private async Task HandleReviewAsync(
        Guid alertId)
    {
        var alert =
            FindAlert(
                alertId);

        if (alert is null)
        {
            return;
        }

        var destination =
            GetReviewDestination(
                alert);

        if (destination is null)
        {
            return;
        }

        if (!alert.IsRead)
        {
            var succeeded =
                await RunAlertMutationAsync(
                    alertId,
                    async module =>
                    {
                        await module
                            .InvokeAsync<object?>(
                                "markAlertRead",
                                alertId.ToString(
                                    "D"));

                        alert.IsRead =
                            true;
                    });

            if (!succeeded)
            {
                return;
            }
        }

        Navigation.NavigateTo(
            destination);
    }

    private async Task<bool>
        RunAlertMutationAsync(
            Guid alertId,
            Func<IJSObjectReference, Task>
                mutation)
    {
        if (_isMutating)
        {
            return false;
        }

        _isMutating =
            true;

        _busyAlertId =
            alertId;

        _actionError =
            null;

        try
        {
            var module =
                await GetBffModuleAsync();

            await mutation(
                module);

            return true;
        }
        catch (JSException)
        {
            _actionError =
                L["FullWorth could not update that alert. Try again."].Value;
        }
        catch (Exception)
        {
            _actionError =
                L["FullWorth could not update that alert. Try again."].Value;
        }
        finally
        {
            _isMutating =
                false;

            _busyAlertId =
                null;

            StateHasChanged();
        }

        return false;
    }

    private BillAlertViewModel?
        FindAlert(
            Guid alertId)
    {
        return _alerts
            .FirstOrDefault(
                alert =>
                    alert.Id ==
                        alertId);
    }

    private static string?
        GetReviewDestination(
            BillAlertViewModel alert)
    {
        if (alert.BillStreamId
            .HasValue)
        {
            return
                $"/app/bills/{alert.BillStreamId.Value:D}";
        }

        if (string.Equals(
                alert.AlertType,
                "ConnectionIssue",
                StringComparison.OrdinalIgnoreCase))
        {
            return
                "/app/account";
        }

        return null;
    }

    private static
        AlertCard.AlertCardViewModel
        ToCardViewModel(
            BillAlertViewModel alert)
    {
        return new
            AlertCard.AlertCardViewModel
        {
            Id =
                    alert.Id,

            BillStreamId =
                    alert.BillStreamId,

            BillChangeId =
                    alert.BillChangeId,

            AlertType =
                    alert.AlertType,

            Severity =
                    alert.Severity,

            Title =
                    alert.Title,

            Message =
                    alert.Message,

            IsRead =
                    alert.IsRead,

            IsDismissed =
                    alert.IsDismissed,

            CreatedAtUtc =
                    alert.CreatedAtUtc,

            UpdatedAtUtc =
                    alert.UpdatedAtUtc
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (_bffModule is null)
        {
            return;
        }

        try
        {
            await _bffModule
                .DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private enum ActivityFilter
    {
        All,
        Unread,
        Attention
    }

    public sealed class BillAlertViewModel
    {
        public Guid Id
        {
            get;
            set;
        }

        public Guid? BillStreamId
        {
            get;
            set;
        }

        public Guid? BillChangeId
        {
            get;
            set;
        }

        public string AlertType
        {
            get;
            set;
        } = string.Empty;

        public string Severity
        {
            get;
            set;
        } = "Info";

        public string Title
        {
            get;
            set;
        } = string.Empty;

        public string Message
        {
            get;
            set;
        } = string.Empty;

        public bool IsRead
        {
            get;
            set;
        }

        public bool IsDismissed
        {
            get;
            set;
        }

        public DateTimeOffset CreatedAtUtc
        {
            get;
            set;
        }

        public DateTimeOffset UpdatedAtUtc
        {
            get;
            set;
        }
    }
}
