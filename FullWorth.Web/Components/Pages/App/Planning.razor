    private static bool RequiresPlanReview(PlanningRecentPaydayPlanViewModel plan) =>
        plan.Shortfall > 0m || plan.Coverage is null || plan.Coverage.SkippedBillCount > 0;

    private sealed class PlanningCoverageViewModel
    {
        public int EligibleBillCount { get; set; }
        public int MissingStatementFactCount { get; set; }
        public int MissingDueDateCount { get; set; }
        public int CurrencyMismatchCount { get; set; }
        public int InvalidStatementAmountCount { get; set; }
        public int PriorCurrencyConflictCount { get; set; }

        public int SkippedBillCount => MissingStatementFactCount + MissingDueDateCount +
            CurrencyMismatchCount + InvalidStatementAmountCount + PriorCurrencyConflictCount;

        public bool IsValid()
        {
            var counts = new long[]
            {
                EligibleBillCount, MissingStatementFactCount, MissingDueDateCount,
                CurrencyMismatchCount, InvalidStatementAmountCount, PriorCurrencyConflictCount
            };
            return counts.All(value => value is >= 0 and <= 500) && counts.Sum() <= 500;
        }
    }

