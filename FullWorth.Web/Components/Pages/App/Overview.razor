@using FullWorth.Core.Formatting
@page "/app"

@using FullWorth.Web.Components.Shared
@using FullWorth.Web.Services

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@layout AppLayout

@implements IAsyncDisposable

@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<Overview> L

<PageTitle>@L["Overview — FullWorth"]</PageTitle>



<div class="app-page overview-page">
    <header class="page-heading overview-heading">
        <div>
            <span class="page-kicker">
                @L["FullWorth home"]
            </span>

            <h1>
                @L["Financial pulse"]
            </h1>

            <p>
                @L["See what changed, what needs attention, and where the evidence leads."]
            </p>
        </div>

        @if (_hasLoadedData)
        {
            <button class="status-check-button"
                    type="button"
                    disabled="@_isCheckingStatus"
                    @onclick="CheckStatusAsync">

                @if (_isCheckingStatus)
                {
                    <span class="status-spinner"></span>
                    <span>@L["Checking…"]</span>
                }
                else
                {
                    <svg class="bw-sprite" aria-hidden="true">
                        <use href="/assets/billwatch-sprites.svg#refresh"></use>
                    </svg>
                    <span>@L["Check status"]</span>
                }
            </button>
        }
    </header>

    @if (!string.IsNullOrWhiteSpace(_refreshError))
    {
        <div class="connection-warning" role="status">
            <p>@_refreshError</p>
        </div>
    }

    @if (ShouldShowMixedConnectionWarning)
    {
        <div class="connection-warning" role="status">
            <p>@L["One of your bank connections needs attention. Other connected banks can keep syncing, but the affected bank needs to be repaired."]</p>
            <a href="/app/account">@L["Review connection"]</a>
        </div>
    }

    @if (_hasLoadedData && !HasActiveConnection && _billStreams.Count > 0)
    {
        <div class="connection-warning" role="status">
            <p>@L["These are saved bill records. No bank connection currently reports active monitoring; review your connections."]</p>
            <a href="/app/account">@L["Review connection"]</a>
        </div>
    }

    @if (_hasLoadedData && _connectionCoverage.MixedSyncCoverage)
    {
        <div class="connection-warning" role="status">
            <p>@L["At least one active bank connection has not reported a successful sync. Recognized bills may be incomplete."]</p>
            <a href="/app/account">@L["Review connection"]</a>
        </div>
    }

    @if (_isLoading)
    {
        <div class="dashboard-loading">
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
        </div>

        <div class="skeleton-panel"></div>
    }
    else if (!string.IsNullOrWhiteSpace(
        _errorMessage))
    {
        <div class="app-error-state">
            <div class="state-symbol">
                <svg class="bw-sprite" aria-hidden="true">
                    <use href="/assets/billwatch-sprites.svg#alert"></use>
                </svg>
            </div>

            <div>
                <h2>
                    @L["We couldn't load your FullWorth overview"]
                </h2>

                <p>
                    @_errorMessage
                </p>
            </div>

            <button type="button"
                    class="secondary-action"
                    @onclick="ReloadAsync">
                @L["Try again"]
            </button>
        </div>
    }
    else if (!HasActiveConnection && _billStreams.Count == 0)
    {
        @if (HasConnectionNeedingAttention)
        {
            <section class="onboarding-card attention-state">
                <div class="onboarding-copy">
                    <span class="page-kicker">
                        @L["Action needed"]
                    </span>

                    <h2>
                        @L["Your bank connection needs attention."]
                    </h2>

                    <p>
                        @L["FullWorth has stopped automatic synchronization for the affected connection until it can be reauthorized."]
                    </p>

                    <a class="onboarding-primary-action"
                       href="/app/account">
                        @L["Review connection"]
                        <svg class="bw-sprite" aria-hidden="true">
                            <use href="/assets/billwatch-sprites.svg#arrow-right"></use>
                        </svg>
                    </a>
                </div>

                <div class="onboarding-visual">
                    <div class="attention-symbol">
                        <svg class="bw-sprite" aria-hidden="true">
                            <use href="/assets/billwatch-sprites.svg#alert"></use>
                        </svg>
                    </div>

                    <strong>
                        @L["Sync paused"]
                    </strong>

                    <span>
                        @L["Your existing FullWorth records remain available."]
                    </span>
                </div>
            </section>
        }
        else
        {
            <section class="onboarding-card">
                <div class="onboarding-copy">
                    <span class="page-kicker">
                        @L["Get started"]
                    </span>

                    <h2>
                        @L["Connect a bank to start reviewing your bills."]
                    </h2>

                    <p>
                        @L["FullWorth uses transaction history to discover recurring bills automatically. Your bank credentials are handled by Plaid, not entered into FullWorth."]
                    </p>

                    <div class="onboarding-trust">
                        <div>
                            <span aria-hidden="true">
                                <svg class="bw-sprite">
                                    <use href="/assets/billwatch-sprites.svg#check"></use>
                                </svg>
                            </span>
                            @L["Read-only financial visibility"]
                        </div>

                        <div>
                            <span aria-hidden="true">
                                <svg class="bw-sprite">
                                    <use href="/assets/billwatch-sprites.svg#check"></use>
                                </svg>
                            </span>
                            @L["No money movement"]
                        </div>

                        <div>
                            <span aria-hidden="true">
                                <svg class="bw-sprite">
                                    <use href="/assets/billwatch-sprites.svg#check"></use>
                                </svg>
                            </span>
                            @L["Disconnect anytime"]
                        </div>
                    </div>

                    <a class="onboarding-primary-action"
                       href="/app/account">
                        @L["Connect a bank"]
                        <svg class="bw-sprite" aria-hidden="true">
                            <use href="/assets/billwatch-sprites.svg#arrow-right"></use>
                        </svg>
                    </a>
                </div>

                <div class="onboarding-steps">
                    <div class="onboarding-step active">
                        <span>1</span>

                        <div>
                            <strong>
                                @L["Connect"]
                            </strong>

                            <small>
                                @L["Securely link your financial institution"]
                            </small>
                        </div>
                    </div>

                    <div class="onboarding-line"></div>

                    <div class="onboarding-step">
                        <span>2</span>

                        <div>
                            <strong>
                                @L["Discover"]
                            </strong>

                            <small>
                                @L["Transaction history reveals recurring bills"]
                            </small>
                        </div>
                    </div>

                    <div class="onboarding-line"></div>

                    <div class="onboarding-step">
                        <span>3</span>

                        <div>
                            <strong>
                                @L["Watch"]
                            </strong>

                            <small>
                                @L["FullWorth keeps monitoring automatically"]
                            </small>
                        </div>
                    </div>
                </div>
            </section>
        }
    }
    else if (_billStreams.Count == 0 &&
             IsWaitingForFirstSync)
    {
        <section class="onboarding-card sync-state">
            <div class="onboarding-copy">
                <span class="page-kicker">
                    @L["Bank connected"]
                </span>

                <h2>
                    @L["FullWorth is preparing your first scan."]
                </h2>

                <p>
                    @L["The bank connection reports an active state, but no successful transaction sync has been reported yet. FullWorth needs imported eligible transactions to identify recurring bills."]
                </p>

                <div class="automatic-monitoring-note">
                    <span class="automatic-dot"></span>

                    <div>
                        <strong>
                            @L["First successful bank sync not yet reported"]
                        </strong>

                        <span>
                            @L["Check progress here or review the bank connection if the scan remains pending."]
                        </span>
                    </div>
                </div>

                <div class="onboarding-progress-actions">
                    <button class="onboarding-secondary-action"
                            type="button"
                            disabled="@_isCheckingStatus"
                            @onclick="CheckStatusAsync">
    
                        @if (_isCheckingStatus)
                        {
                            <span class="status-spinner"></span>
                            <span>@L["Checking status…"]</span>
                        }
                        else
                        {
                            <span>@L["Check for progress"]</span>
                            <svg class="bw-sprite" aria-hidden="true">
                                <use href="/assets/billwatch-sprites.svg#refresh"></use>
                            </svg>
                        }
                    </button>
                    <a class="onboarding-secondary-action" href="/app/account">
                        @L["Review connection"]
                        <svg class="bw-sprite" aria-hidden="true">
                            <use href="/assets/billwatch-sprites.svg#arrow-right"></use>
                        </svg>
                    </a>
                </div>
            </div>

            <div class="scan-visual">
                <div class="scan-rings">
                    <div class="scan-ring-middle">
                        <div class="scan-ring-inner">
                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.7"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">

                                <path d="M3 10h18" />
                                <path d="M5 10v8" />
                                <path d="M9 10v8" />
                                <path d="M15 10v8" />
                                <path d="M19 10v8" />
                                <path d="M2 21h20" />
                                <path d="M12 3L2 8h20z" />
                            </svg>
                        </div>
                    </div>
                </div>

                <strong>
                    @L["Connected"]
                </strong>

                <span>
                    @L["Waiting for first successful synchronization"]
                </span>
            </div>
        </section>
    }
    else if (_billStreams.Count == 0)
    {
        <section class="onboarding-card history-state">
            <div class="onboarding-copy">
                <span class="page-kicker">
                    @L["No recognized bills yet"]
                </span>

                <h2>
                    @L["No supported recurring bills found yet."]
                </h2>

                <p>
                    @L["No active recurring bills were returned. This does not prove that you have no bills or that every transaction has been imported. Review your bills, connections, and transaction history."]
                </p>

                @if (LatestSuccessfulSync is not null)
                {
                    <div class="last-sync-note">
                        <span>
                            @L["Last successful sync"]
                        </span>

                        <strong>
                            <time datetime="@LatestSuccessfulSync.Value.ToString("O")">
                                @FormatTimestampFallback(
                                    LatestSuccessfulSync.Value)
                            </time>
                        </strong>
                    </div>
                }

                <a class="onboarding-secondary-action link-action"
                   href="/app/bills">
                    @L["Review bills and history"]
                    <svg class="bw-sprite" aria-hidden="true">
                        <use href="/assets/billwatch-sprites.svg#arrow-right"></use>
                    </svg>
                </a>
            </div>

            <div class="history-visual">
                <div class="history-symbol">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.7"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <path d="M12 8v4l3 2" />
                        <circle cx="12"
                                cy="12"
                                r="9" />
                    </svg>
                </div>

                <strong>
                    @L["Building history"]
                </strong>

                <span>
                    @L["FullWorth only creates a recurring bill when the evidence supports it."]
                </span>
            </div>
        </section>
    }
    else
    {
        @if (HasConnectionNeedingAttention)
        {
            <div class="connection-warning">
                <div class="connection-warning-icon">
                    <svg class="bw-sprite" aria-hidden="true">
                        <use href="/assets/billwatch-sprites.svg#alert"></use>
                    </svg>
                </div>

                <div>
                    <strong>
                        @L["One of your bank connections needs attention."]
                    </strong>

                    <span>
                        @L["FullWorth can continue showing existing data, but that connection will not refresh until it is repaired."]
                    </span>
                </div>

                <a href="/app/account">
                    @L["Review"]
                </a>
            </div>
        }

        <OverviewBillSummary Summary="_summary" LatestSuccessfulSync="LatestSuccessfulSync"
                            ActiveConnectionCount="_connectionCoverage.ActiveCount"
                            SyncedConnectionCount="_connectionCoverage.SyncedCount" />

        <section class="fw-overview-grid">
            <article class="fw-watchlist">
                <div class="fw-section-heading">
                    <div>
                        <span class="panel-kicker">
                            @L["Recurring bills"]
                        </span>

                        <h2>
                            @L["Your watchlist"]
                        </h2>
                    </div>

                    <a href="/app/bills"
                       class="fw-inline-action">
                        @L["View all"]
                        <svg class="bw-sprite" aria-hidden="true">
                            <use href="/assets/billwatch-sprites.svg#arrow-right"></use>
                        </svg>
                    </a>
                </div>

                <p class="fw-watchlist-scope">@L["Bills with supported increases appear first; others are listed by provider name. Amounts in different currencies are never ranked against each other."]</p>

                <div class="fw-bill-list">
                    @foreach (var bill in WatchlistBills)
                    {
                        var difference =
                            GetDifference(
                                bill);

                        <a class="fw-bill-row"
                           href="@($"/app/bills/{bill.Id}")">
                            <div class="fw-bill-logo">
                                <ProviderLogo ProviderName="@bill.ProviderName" />
                            </div>

                            <div class="fw-bill-copy">
                                <strong>
                                    @bill.ProviderName
                                </strong>

                                <span>
                                    @FormatCategory(
                                        bill.Category)
                                </span>
                            </div>

                            <div class="fw-bill-value">
                                <strong>
                                    @(bill.HasTransactionEvidence ? FormatMoney(bill.CurrentAmount, bill.CurrencyCode) : L["Amount unavailable"].Value)
                                </strong>

                                @if (OverviewBillCoverage.CanCompare(ToFact(bill)))
                                {
                                    <span class="@GetDifferenceClass(
                                        difference)">
                                        @FormatDifference(difference, bill.CurrencyCode)
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        @L["Comparison unavailable"]
                                    </span>
                                }
                            </div>

                            <span class="fw-row-chevron"
                                  aria-hidden="true">›</span>
                        </a>
                    }
                </div>
            </article>

            <aside class="fw-signal-card">
                <OverviewBillSummary Summary="_summary" StatusOnly="true" />
            </aside>
        </section>

        <section class="fw-destination-row" aria-label="@L["Quick links"]">
            @foreach (var destination in _quickLinkOrder)
            {
                @switch (destination)
                {
                    case "transactions":
                        <a href="/app/account/transactions" class="fw-destination">
                            <span class="fw-destination-icon" aria-hidden="true">
                                <svg class="bw-sprite">
                                    <use href="/assets/billwatch-sprites.svg#transactions"></use>
                                </svg>
                            </span>
                            <span>
                                <strong>@L["Transactions"]</strong>
                                <small>@L["Review recent account activity"]</small>
                            </span>
                            <span aria-hidden="true">→</span>
                        </a>
                        break;

                    case "accounts":
                        <a href="/app/account" class="fw-destination">
                            <span class="fw-destination-icon" aria-hidden="true">
                                <svg class="bw-sprite">
                                    <use href="/assets/billwatch-sprites.svg#bank"></use>
                                </svg>
                            </span>
                            <span>
                                <strong>@L["Accounts"]</strong>
                                <small>@L["Manage bank connections"]</small>
                            </span>
                            <span aria-hidden="true">→</span>
                        </a>
                        break;

                    case "activity":
                        <a href="/app/activity" class="fw-destination">
                            <span class="fw-destination-icon" aria-hidden="true">
                                <svg class="bw-sprite">
                                    <use href="/assets/billwatch-sprites.svg#activity"></use>
                                </svg>
                            </span>
                            <span>
                                <strong>@L["Activity"]</strong>
                                <small>@L["See alerts and important changes"]</small>
                            </span>
                            <span aria-hidden="true">→</span>
                        </a>
                        break;
                }
            }
        </section>
    }
</div>

@code {
    private IJSObjectReference?
        _bffModule;

    private List<BillStreamViewModel>
        _billStreams = [];

    // Comparison status determines urgency; raw amount does not rank different currencies.
    private IReadOnlyList<BillStreamViewModel> WatchlistBills =>
        _billStreams
            .OrderByDescending(bill => OverviewBillCoverage.Difference(ToFact(bill)) > 0m)
            .ThenByDescending(bill => OverviewBillCoverage.CanCompare(ToFact(bill)))
            .ThenBy(bill => bill.ProviderName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(bill => bill.Id)
            .Take(6)
            .ToArray();

    private List<BankConnectionViewModel>
        _connections = [];

    private IReadOnlyList<string> _quickLinkOrder =
        ExperienceFocusOrdering.OrderQuickLinks(
            []);

    private bool _isLoading =
        true;

    private bool _isCheckingStatus;

    private string? _errorMessage;

    private bool ShouldShowMixedConnectionWarning =>
        _hasLoadedData &&
        HasActiveConnection &&
        HasConnectionNeedingAttention &&
        _billStreams.Count == 0;

    private bool HasActiveConnection { get; set; }

    private bool HasConnectionNeedingAttention { get; set; }

    private bool IsWaitingForFirstSync { get; set; }

    private DateTimeOffset? LatestSuccessfulSync { get; set; }

    private OverviewBillCoverage _summary = OverviewBillCoverage.Create([]);
    private OverviewConnectionCoverage _connectionCoverage = OverviewConnectionCoverage.Create([]);
    private bool _hasLoadedData;
    private bool _disposed;
    private string? _refreshError;

    protected override async Task
        OnAfterRenderAsync(
            bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadAsync();

        if (!_disposed)
            StateHasChanged();
    }

    private async Task<
        IJSObjectReference>
        GetBffModuleAsync()
    {
        _bffModule ??=
            await JS.InvokeAsync<
                IJSObjectReference>(
                "import",
                "./js/bff.js");

        return _bffModule;
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
    }

    private async Task CheckStatusAsync()
    {
        if (_isCheckingStatus || _isLoading || _disposed)
        {
            return;
        }

        _isCheckingStatus = true;
        _refreshError = null;

        try
        {
            await LoadDataAsync();
        }
        catch (Exception)
        {
            if (!_disposed)
                _refreshError = L["The overview could not be refreshed. Previously loaded records are still shown and may be out of date. Check status to retry."].Value;
        }
        finally
        {
            _isCheckingStatus =
                false;
        }
    }

    private async Task LoadAsync()
    {
        _isLoading =
            true;

        _errorMessage =
            null;

        try
        {
            await LoadDataAsync();
        }
        catch (JSException)
        {
            _errorMessage =
                L["FullWorth could not reach the secure API. Try again in a moment."].Value;
        }
        catch (Exception)
        {
            _errorMessage =
                L["Something went wrong while loading your FullWorth overview."].Value;
        }
        finally
        {
            _isLoading =
                false;
        }
    }

    private async Task LoadDataAsync()
    {
        var module =
            await GetBffModuleAsync();

        var connectionTask =
            module
                .InvokeAsync<
                    BankConnectionViewModel[]>(
                    "getBankConnections")
                .AsTask();

        var billStreamTask =
            module
                .InvokeAsync<
                    BillStreamViewModel[]>(
                    "getBillStreams")
                .AsTask();

        var preferenceTask = LoadOptionalPreferencesAsync(module);

        await Task.WhenAll(
            connectionTask,
            billStreamTask,
            preferenceTask);

        var connections = connectionTask.Result
            ?? throw new InvalidOperationException("Connection snapshot unavailable.");
        var bills = billStreamTask.Result
            ?? throw new InvalidOperationException("Bill snapshot unavailable.");
        if (connections.Any(connection => connection is null || connection.Id == Guid.Empty) ||
            bills.Any(bill => bill is null || bill.Id == Guid.Empty) ||
            connections.Select(connection => connection.Id).Distinct().Count() != connections.Length ||
            bills.Select(bill => bill.Id).Distinct().Count() != bills.Length)
        {
            throw new InvalidOperationException("Invalid overview snapshot.");
        }

        var activeBills = bills.Where(bill => bill.IsActive).ToList();
        var summary = OverviewBillCoverage.Create(activeBills.Select(ToFact));
        if (_disposed)
            return;

        // Commit a complete, validated snapshot together; partial reads cannot erase it.
        _connections = connections.ToList();
        _billStreams = activeBills;
        _summary = summary;
        if (preferenceTask.Result is { } preferences)
            _quickLinkOrder = ExperienceFocusOrdering.OrderQuickLinks(preferences.ExperienceFocus);
        UpdateOverviewSummaries();
        _hasLoadedData = true;
    }

    private static async Task<ExperiencePreferenceViewModel?> LoadOptionalPreferencesAsync(
        IJSObjectReference module)
    {
        try
        {
            return await module.InvokeAsync<ExperiencePreferenceViewModel>("getExperiencePreferences");
        }
        catch (Exception)
        {
            // Optional presentation preferences must not hide readable financial records.
            return null;
        }
    }

    private void UpdateOverviewSummaries()
    {
        _connectionCoverage = OverviewConnectionCoverage.Create(
            _connections.Select(connection => new OverviewConnectionFact(
                connection.Status, connection.LastSuccessfulSyncAtUtc)));

        HasActiveConnection = _connectionCoverage.ActiveCount > 0;
        HasConnectionNeedingAttention =
            _connections.Any(connection => connection.Status == 1);

        IsWaitingForFirstSync = _connectionCoverage.WaitingForInitialSync;
        LatestSuccessfulSync = _connectionCoverage.MostRecentSuccessfulSync;
    }

    private static OverviewBillFact ToFact(BillStreamViewModel bill) => new(
        bill.Id, bill.ProviderName, bill.IsActive, bill.HasTransactionEvidence,
        bill.HasMonthlyCadenceEvidence, bill.CurrentAmount, bill.PreviousAverage, bill.CurrencyCode);

    private static decimal GetDifference(BillStreamViewModel bill) =>
        OverviewBillCoverage.Difference(ToFact(bill));

    private string FormatMoney(decimal amount, string? currencyCode) =>
        FinancialAmountFormatter.FormatOrUnspecified(amount, currencyCode, L["Currency unavailable"].Value);

    private string FormatDifference(
        decimal difference, string? currencyCode)
    {
        if (difference > 0m)
        {
            return $"+{FormatMoney(difference, currencyCode)}";
        }

        if (difference < 0m)
        {
            return $"-{FormatMoney(Math.Abs(difference), currencyCode)}";
        }

        return L["No change"].Value;
    }

    private static string
        GetDifferenceClass(
            decimal difference)
    {
        if (difference > 0m)
        {
            return "amount-increase";
        }

        if (difference < 0m)
        {
            return "amount-decrease";
        }

        return "amount-steady";
    }

    private string FormatCategory(
        string category)
    {
        if (string.IsNullOrWhiteSpace(
                category) ||
            string.Equals(
                category,
                "Unknown",
                StringComparison.OrdinalIgnoreCase))
        {
            return L["Recurring bill"].Value;
        }

        return category switch
        {
            "MobilePhone" =>
                L["Mobile phone"].Value,

            "NaturalGas" =>
                L["Natural gas"].Value,

            _ =>
                L[category].Value
        };
    }

    private static string FormatTimestampFallback(
        DateTimeOffset value)
    {
        return value.ToUniversalTime()
            .ToString(
                "MM/dd/yyyy HH:mm 'UTC'");
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_bffModule is null)
        {
            return;
        }

        try
        {
            await _bffModule
                .DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public sealed class ExperiencePreferenceViewModel
    {
        public string[] ExperienceFocus
        {
            get;
            set;
        } = [];
    }

    public sealed class BillStreamViewModel
    {
        public Guid Id { get; set; }

        public string ProviderName
        {
            get;
            set;
        } = string.Empty;

        public string Category
        {
            get;
            set;
        } = string.Empty;

        public bool IsActive
        {
            get;
            set;
        }

        public string? CurrencyCode { get; set; }
        public bool HasTransactionEvidence { get; set; }
        public bool HasMonthlyCadenceEvidence { get; set; }

        public decimal CurrentAmount
        {
            get;
            set;
        }

        public decimal PreviousAverage
        {
            get;
            set;
        }
    }

    public sealed class BankConnectionViewModel
    {
        public Guid Id { get; set; }

        public string InstitutionName
        {
            get;
            set;
        } = string.Empty;

        public int Status
        {
            get;
            set;
        }

        public DateTimeOffset?
            LastSuccessfulSyncAtUtc
        {
            get;
            set;
        }

        public DateTimeOffset CreatedAtUtc
        {
            get;
            set;
        }
    }
}
