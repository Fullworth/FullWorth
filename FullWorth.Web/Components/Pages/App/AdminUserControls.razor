@implements IAsyncDisposable

@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<AdminUserControls> L

<div class="admin-user-controls-shell">
    @if (IsOwner)
    {
        <span class="admin-user-protected">
            @L["Owner is protected from normal staff and entitlement mutations."]
        </span>
    }
    else if (_pending is not null)
    {
        <div class="admin-user-confirm">
            <span>@L["Confirm: {0}", _pending.Label]</span>

            @if (RequiresRoleAssignmentReauthentication)
            {
                <label class="admin-user-reauth-field">
                    <span>@L["Current password"]</span>
                    <input type="password"
                           autocomplete="current-password"
                           disabled="@_isBusy"
                           @bind="_roleCurrentPassword" />
                </label>

                <label class="admin-user-reauth-field">
                    <span>@L["Authenticator code (if enabled)"]</span>
                    <input type="text"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           maxlength="12"
                           disabled="@_isBusy"
                           @bind="_roleTwoFactorCode" />
                </label>
            }

            <button type="button"
                    class="admin-user-control danger"
                    disabled="@_isBusy"
                    @onclick="ConfirmAsync">
                @(_isBusy ? L["Working…"] : L["Confirm"])
            </button>

            <button type="button"
                    class="admin-user-control"
                    disabled="@_isBusy"
                    @onclick="Cancel">
                @L["Cancel"]
            </button>
        </div>
    }
    else
    {
        <div class="admin-user-controls">
            <button type="button"
                    class="admin-user-control"
                    disabled="@_isBusy"
                    @onclick="QueueAdminRole">
                @(HasRole(AdminRole) ? L["Remove admin"] : L["Make admin"])
            </button>

            <button type="button"
                    class="admin-user-control"
                    disabled="@_isBusy"
                    @onclick="QueueModeratorRole">
                @(HasRole(ModeratorRole) ? L["Remove moderator"] : L["Make moderator"])
            </button>

            <button type="button"
                    class="admin-user-control"
                    disabled="@_isBusy"
                    @onclick="QueueBetaProgram">
                @(HasProgram(BetaProgram) ? L["Remove beta tester"] : L["Add beta tester"])
            </button>

            <button type="button"
                    class="admin-user-control"
                    disabled="@_isBusy"
                    @onclick="QueueInternalProgram">
                @(HasProgram(InternalProgram) ? L["Remove internal tester"] : L["Add internal tester"])
            </button>

            <button type="button"
                    class="admin-user-control accent"
                    disabled="@_isBusy"
                    @onclick="QueueThirtyDayGrant">
                @L["Grant 30 days"]
            </button>

            <button type="button"
                    class="admin-user-control accent"
                    disabled="@_isBusy"
                    @onclick="QueueLifetimeGrant">
                @L["Grant lifetime"]
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <span class="admin-user-control-error" role="alert">@_errorMessage</span>
    }
</div>

@code {
    private const string OwnerRole = "Owner";
    private const string AdminRole = "Admin";
    private const string ModeratorRole = "Moderator";
    private const string BetaProgram = "BetaTester";
    private const string InternalProgram = "InternalTester";

    [Parameter]
    public Guid UserId { get; set; }

    [Parameter]
    public IReadOnlyList<string> Roles { get; set; } = [];

    [Parameter]
    public IReadOnlyList<string> Programs { get; set; } = [];

    private IJSObjectReference? _adminModule;
    private PendingMutation? _pending;
    private bool _isBusy;
    private string? _errorMessage;
    private string _roleCurrentPassword = string.Empty;
    private string _roleTwoFactorCode = string.Empty;

    private bool IsOwner => HasRole(OwnerRole);

    private bool RequiresRoleAssignmentReauthentication =>
        _pending is
        {
            Kind:
                AdminMutationKind.Role,
            MakeActive:
                true
        };

    private void QueueAdminRole() =>
        QueueRole(AdminRole, !HasRole(AdminRole));

    private void QueueModeratorRole() =>
        QueueRole(ModeratorRole, !HasRole(ModeratorRole));

    private void QueueBetaProgram() =>
        QueueProgram(BetaProgram, !HasProgram(BetaProgram));

    private void QueueInternalProgram() =>
        QueueProgram(InternalProgram, !HasProgram(InternalProgram));

    private void QueueThirtyDayGrant()
    {
        _errorMessage = null;
        _pending = new PendingMutation(
            AdminMutationKind.Entitlement,
            L["Grant Standard access for 30 days"],
            null,
            true,
            30,
            false);
    }

    private void QueueLifetimeGrant()
    {
        _errorMessage = null;
        _pending = new PendingMutation(
            AdminMutationKind.Entitlement,
            L["Grant lifetime Standard access"],
            null,
            true,
            null,
            true);
    }

    private void QueueRole(string role, bool makeActive)
    {
        _errorMessage = null;
        _pending = new PendingMutation(
            AdminMutationKind.Role,
            makeActive
                ? L["Assign {0} role", LocalizeRole(role)]
                : L["Remove {0} role", LocalizeRole(role)],
            role,
            makeActive,
            null,
            false);
    }

    private void QueueProgram(string program, bool makeActive)
    {
        _errorMessage = null;
        _pending = new PendingMutation(
            AdminMutationKind.Program,
            makeActive
                ? L["Add {0} membership", FormatProgram(program)]
                : L["Remove {0} membership", FormatProgram(program)],
            program,
            makeActive,
            null,
            false);
    }

    private void Cancel()
    {
        if (!_isBusy)
        {
            _pending = null;
            _errorMessage = null;
            ClearRoleReauthentication();
        }
    }

    private async Task ConfirmAsync()
    {
        if (_isBusy || _pending is null || UserId == Guid.Empty)
        {
            return;
        }

        if (RequiresRoleAssignmentReauthentication &&
            string.IsNullOrWhiteSpace(
                _roleCurrentPassword))
        {
            _errorMessage =
                L["Enter your current password before assigning a staff role."];
            return;
        }

        _isBusy = true;
        _errorMessage = null;

        try
        {
            var module = await GetAdminModuleAsync();
            var result = _pending.Kind switch
            {
                AdminMutationKind.Role => await MutateRoleAsync(module, _pending),
                AdminMutationKind.Program => await MutateProgramAsync(module, _pending),
                AdminMutationKind.Entitlement => await GrantEntitlementAsync(module, _pending),
                _ => throw new InvalidOperationException()
            };

            if (result.AccessDenied)
            {
                _errorMessage = L["FullWorth blocked that change because your staff role cannot manage this account."];
                return;
            }

            _pending = null;
            ClearRoleReauthentication();
            Navigation.NavigateTo("/app/admin", forceLoad: true);
        }
        catch (JSException exception)
        {
            _errorMessage =
                GetSafeMutationError(
                    exception.Message);
        }
        catch (Exception)
        {
            _errorMessage = L["FullWorth could not complete that administrative change."];
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task<AdminFetchResult<object>> MutateRoleAsync(
        IJSObjectReference module,
        PendingMutation mutation)
    {
        var functionName = mutation.MakeActive
            ? "assignAdminRole"
            : "removeAdminRole";

        if (!mutation.MakeActive)
        {
            return await module.InvokeAsync<AdminFetchResult<object>>(
                functionName,
                UserId.ToString("D"),
                mutation.Name);
        }

        return await module.InvokeAsync<AdminFetchResult<object>>(
            functionName,
            UserId.ToString("D"),
            mutation.Name,
            new AdminAssignRoleRequest
            {
                CurrentPassword =
                    _roleCurrentPassword,
                TwoFactorCode =
                    string.IsNullOrWhiteSpace(
                        _roleTwoFactorCode)
                        ? null
                        : _roleTwoFactorCode.Trim()
            });
    }

    private async Task<AdminFetchResult<object>> MutateProgramAsync(
        IJSObjectReference module,
        PendingMutation mutation)
    {
        return await module.InvokeAsync<AdminFetchResult<object>>(
            "setAdminProgram",
            UserId.ToString("D"),
            mutation.Name,
            new AdminProgramRequest
            {
                IsActive = mutation.MakeActive,
                EndsAtUtc = null
            });
    }

    private async Task<AdminFetchResult<object>> GrantEntitlementAsync(
        IJSObjectReference module,
        PendingMutation mutation)
    {
        return await module.InvokeAsync<AdminFetchResult<object>>(
            "grantAdminEntitlement",
            UserId.ToString("D"),
            new AdminEntitlementRequest
            {
                Tier = "Standard",
                DurationDays = mutation.DurationDays,
                GrantsLifetimeAccess = mutation.GrantsLifetimeAccess
            });
    }

    private string GetSafeMutationError(
        string? technicalMessage)
    {
        if (!string.IsNullOrWhiteSpace(
                technicalMessage))
        {
            if (technicalMessage.Contains(
                    "current password is incorrect",
                    StringComparison.OrdinalIgnoreCase))
            {
                return L["Your current password is incorrect."];
            }

            if (technicalMessage.Contains(
                    "authenticator code",
                    StringComparison.OrdinalIgnoreCase))
            {
                return L["Enter a valid current authenticator code if two-factor authentication is enabled."];
            }
        }

        return L["FullWorth could not complete that administrative change."];
    }

    private void ClearRoleReauthentication()
    {
        _roleCurrentPassword =
            string.Empty;

        _roleTwoFactorCode =
            string.Empty;
    }

    private async Task<IJSObjectReference> GetAdminModuleAsync()
    {
        _adminModule ??= await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./js/admin-bff.js");

        return _adminModule;
    }

    private bool HasRole(string roleName) =>
        Roles.Any(role => string.Equals(
            role,
            roleName,
            StringComparison.OrdinalIgnoreCase));

    private bool HasProgram(string programName) =>
        Programs.Any(program => string.Equals(
            program,
            programName,
            StringComparison.OrdinalIgnoreCase));

    private string LocalizeRole(string role) =>
        role switch
        {
            OwnerRole => L["Owner"],
            AdminRole => L["Admin"],
            ModeratorRole => L["Moderator"],
            _ => role
        };

    private string FormatProgram(string program) =>
        program switch
        {
            BetaProgram => L["beta tester"],
            InternalProgram => L["internal tester"],
            _ => program
        };

    public async ValueTask DisposeAsync()
    {
        if (_adminModule is null)
        {
            return;
        }

        try
        {
            await _adminModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private enum AdminMutationKind
    {
        Role,
        Program,
        Entitlement
    }

    private sealed record PendingMutation(
        AdminMutationKind Kind,
        string Label,
        string? Name,
        bool MakeActive,
        int? DurationDays,
        bool GrantsLifetimeAccess);

    private sealed class AdminFetchResult<T>
    {
        public bool AccessDenied { get; set; }
        public T? Value { get; set; }
    }

    private sealed class AdminAssignRoleRequest
    {
        public string CurrentPassword { get; set; } =
            string.Empty;

        public string? TwoFactorCode { get; set; }
    }

    private sealed class AdminProgramRequest
    {
        public bool IsActive { get; set; }
        public DateTimeOffset? EndsAtUtc { get; set; }
    }

    private sealed class AdminEntitlementRequest
    {
        public string Tier { get; set; } = string.Empty;
        public int? DurationDays { get; set; }
        public bool GrantsLifetimeAccess { get; set; }
    }
}
