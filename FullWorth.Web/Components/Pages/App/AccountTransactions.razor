@page "/app/account/transactions"

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using FullWorth.Web.Presentation

@layout AppLayout

@implements IAsyncDisposable

@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<AccountTransactions> L

<PageTitle>@L["Transactions — FullWorth"]</PageTitle>

<link rel="stylesheet"
      href="/account-transactions.css" />

<div class="app-page">
    <a class="transaction-back-link fw-back-link"
       href="/app/account">
        <svg class="bw-sprite" aria-hidden="true">
            <use href="/assets/billwatch-sprites.svg#chevron-left"></use>
        </svg>
        @L["Account"]
    </a>

    <header class="page-heading">
        <div>
            <span class="page-kicker">
                @L["Transaction ledger"]
            </span>

            <h1>
                @L["Transactions"]
            </h1>

            <p>
                @L["The connected-bank activity FullWorth uses to discover recurring bills."]
            </p>
        </div>

        <button type="button"
                class="secondary-action"
                disabled="@(_isLoading || _isRefreshing || _isLoadingMore)"
                aria-busy="@_isRefreshing"
                @onclick="SyncNowAsync">
            @(_isRefreshing
                ? L["Syncing…"]
                : L["Sync now"])
        </button>
    </header>

    @if (_isLoading)
    {
        <div class="transaction-summary-grid">
            <div class="transaction-skeleton"></div>
            <div class="transaction-skeleton"></div>
            <div class="transaction-skeleton"></div>
        </div>

        <div class="transaction-list-skeleton"></div>
    }
    else if (!string.IsNullOrWhiteSpace(
        _errorMessage))
    {
        <div class="app-error-state">
            <div class="state-symbol">
                !
            </div>

            <div>
                <h2>
                    @L["We couldn't load transactions"]
                </h2>

                <p>
                    @_errorMessage
                </p>
            </div>

            <button type="button"
                    class="secondary-action"
                    @onclick="ReloadAsync">
                @L["Try again"]
            </button>
        </div>
    }
    else
    {
        var filteredTransactions =
            FilteredTransactions;

        @if (!string.IsNullOrWhiteSpace(_syncError))
        {
            <div class="transaction-history-error" role="alert">@_syncError</div>
        }
        @if (!string.IsNullOrWhiteSpace(_accountFilterResetNotice))
        {
            <p class="transaction-history-note" role="status">@_accountFilterResetNotice</p>
        }

        <section class="transaction-evidence-note" aria-labelledby="transaction-evidence-heading">
            <h2 id="transaction-evidence-heading">@L["Spending is not the same as recurring bills"]</h2>
            <p>@L["This ledger includes purchases, transfers, and other bank activity. Only supported recurring-payment evidence becomes a monitored bill; the bill total is not your total spending."]</p>
            <a href="/app/bills">@L["Review monitored bills and discovery details"]</a>
        </section>

        <section class="fw-transactions-pulse">
            <div class="fw-transactions-total">
                <span>@L["Posted outflow"]</span>
                <strong>
                    @(_outflowSummary.Totals ?? L["No known-currency posted outflow"].Value)
                </strong>
                <small>@L["Across the currently loaded transaction history; filters below affect rows only."]</small>
                @if (_transactions.Count > 0)
                {
                    <small>@L["Loaded dates: {0} – {1}. This is not proof of complete bank coverage.",
                        _transactions.Min(transaction => transaction.PostedDate).ToString("d", System.Globalization.CultureInfo.CurrentUICulture),
                        _transactions.Max(transaction => transaction.PostedDate).ToString("d", System.Globalization.CultureInfo.CurrentUICulture)]</small>
                }
                <small>@L["Totals are separated by currency. No currency conversion is applied."]</small>
                @if (_outflowSummary.UnknownCurrencyCount > 0)
                {
                    <small role="status">@L["{0} posted outflow records have unavailable currency and are excluded from totals.", _outflowSummary.UnknownCurrencyCount]</small>
                }
            </div>

            <div class="fw-transactions-stats">
                <div>
                    <span>@L["Loaded"]</span>
                    <strong>@_transactions.Count</strong>
                    <small>@L["Latest {0} records available in this view", _transactionLoadLimit]</small>
                </div>

                <div class="@(_pendingCount > 0 ? "has-pending" : string.Empty)">
                    <span>@L["Pending"]</span>
                    <strong>@_pendingCount</strong>
                    <small>@L["Not yet final"]</small>
                </div>
            </div>
        </section>

        <section class="fw-transactions-ledger">
            <div class="fw-transactions-toolbar">
                <div>
                    <span class="panel-kicker">@L["Transactions"]</span>
                    <h2>@L["Account activity"]</h2>
                </div>

                <div class="transaction-toolbar">
                    <div class="transaction-search">
                        <svg class="bw-sprite" aria-hidden="true">
                            <use href="/assets/billwatch-sprites.svg#search"></use>
                        </svg>

                        @if (_useLocalTransactionFiltering)
                        {
                            <input id="transaction-search-local"
                                   type="search"
                                   aria-label="@L["Search merchant or transaction"]"
                                   placeholder="@L["Search merchant or transaction"]"
                                   autocomplete="off" />
                        }
                        else
                        {
                            <input type="search"
                                   aria-label="@L["Search merchant or transaction"]"
                                   placeholder="@L["Search merchant or transaction"]"
                                   autocomplete="off"
                                   @bind="_searchText"
                                   @bind:event="oninput" />
                        }
                    </div>

                    @if (_useLocalTransactionFiltering)
                    {
                        <select id="transaction-account-filter-local"
                                class="transaction-account-filter"
                                aria-label="@L["Filter by account"]">

                            <option value="">
                                @L["All accounts"]
                            </option>

                            @foreach (var account
                                in _availableAccounts)
                            {
                                <option value="@account.Id.ToString("D")">
                                    @GetAccountFilterLabel(
                                        account)
                                </option>
                            }
                        </select>
                    }
                    else
                    {
                        <select class="transaction-account-filter"
                                aria-label="@L["Filter by account"]"
                                @bind="_selectedAccountId">

                            <option value="">
                                @L["All accounts"]
                            </option>

                            @foreach (var account
                                in _availableAccounts)
                            {
                                <option value="@account.Id.ToString("D")">
                                    @GetAccountFilterLabel(
                                        account)
                                </option>
                            }
                        </select>
                    }
                </div>
            </div>

            <div class="transaction-result-line">
            <span aria-live="polite" aria-atomic="true" id="@(_useLocalTransactionFiltering
                        ? "transaction-result-count-local"
                        : null)"
                  data-singular-label="@L["1 transaction"]"
                  data-plural-template="@L["{0} transactions", "{count}"]">
                @GetTransactionsResultLabel(
                    filteredTransactions.Count)
            </span>

            <div class="transaction-history-actions">
                @if (_transactions.Count == _transactionLoadLimit)
                {
                    <small>
                        @L["Showing the newest {0} records", _transactionLoadLimit]
                    </small>
                }

                @if (CanLoadMoreTransactions ||
                     _isLoadingMore)
                {
                    <button type="button"
                            class="transaction-history-load-button"
                            disabled="@_isLoadingMore"
                            @onclick="LoadMoreAsync">
                        @(_isLoadingMore
                            ? L["Loading older…"]
                            : L["Load older transactions"])
                    </button>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(
            _loadMoreError))
        {
            <div class="transaction-history-error"
                 role="alert">
                @_loadMoreError
            </div>
        }

        @if (_transactions.Count == 0)
        {
            <section class="transaction-empty">
                <div>
                    <svg class="bw-sprite" aria-hidden="true">
                        <use href="/assets/billwatch-sprites.svg#transactions"></use>
                    </svg>
                </div>

                <h2>
                    @L["No transactions yet."]
                </h2>

                <p>
                    @L["Transactions appear after an active bank connection completes synchronization."]
                </p>
            </section>
        }
        else if (!_useLocalTransactionFiltering &&
                 filteredTransactions.Count == 0)
        {
            <section class="transaction-empty compact">
                <h2>
                    @L["No matching transactions."]
                </h2>

                <p>
                    @L["Change the account or search filter."]
                </p>
            </section>
        }
        else
        {
            @if (_useLocalTransactionFiltering)
            {
                <section id="transaction-local-empty"
                         class="transaction-empty compact"
                         hidden>
                    <h2>
                        @L["No matching transactions."]
                    </h2>

                    <p>
                        @L["Change the account or search filter."]
                    </p>
                </section>
            }

            <section class="transaction-list">
                @foreach (var transaction
                    in filteredTransactions)
                {
                    <article class="transaction-row" @key="transaction.Id"
                             data-fullworth-transaction-id="@transaction.Id.ToString("D")">
                        <div class="@GetTransactionIconClass(
                                                                        transaction.Amount)">
                            @GetTransactionIconText(
                                transaction.Amount)
                        </div>

                        <div class="transaction-copy">
                            <div class="transaction-title-line">
                                <strong>
                                    @GetTransactionName(
                                        transaction)
                                </strong>

                                @if (transaction.IsPending)
                                {
                                    <span class="pending-pill">
                                        @L["Pending"]
                                    </span>
                                }
                            </div>

                            <span>
                                @transaction.InstitutionName
                                ·
                                @transaction.AccountName

                                @if (!string.IsNullOrWhiteSpace(
                                    transaction.AccountMask))
                                {
                                    <text>
                                        · •••• @transaction.AccountMask
                                    </text>
                                }
                            </span>

                            <small class="transaction-mobile-date">
                                @(transaction.PostedDate.ToString("d MMM yyyy", System.Globalization.CultureInfo.CurrentUICulture))
                            </small>

                            @if (!string.IsNullOrWhiteSpace(
                                transaction.CategoryPrimary))
                            {
                                <small>
                                    @FormatCategory(
                                        transaction.CategoryPrimary)
                                </small>
                            }
                        </div>

                        <div class="transaction-date">
                            <strong>
                                @(transaction.PostedDate.ToString("MMM d", System.Globalization.CultureInfo.CurrentUICulture))
                            </strong>

                            <span>
                                @transaction.PostedDate.Year
                            </span>
                        </div>

                        <div class="@GetAmountClass(
                                                                        transaction.Amount)">
                            @TransactionLedgerPresentation.FormatSigned(transaction.Amount, transaction.IsoCurrencyCode, L["Currency unavailable"])
                        </div>
                    </article>
                }
            </section>
        }

            <div class="transaction-explanation">
                @L["Plaid reports purchase/outflow amounts as positive transaction values. FullWorth displays those as money leaving the account and credits as money returning."]
            </div>
        </section>
    }
</div>

@code {
    private const int ExpandedTransactionLoadLimit =
        250;

    private const int MaximumTransactionLoadLimit =
        500;

    private int _transactionLoadLimit =
        MaximumTransactionLoadLimit;

    private bool _hasResolvedInitialTransactionLoadLimit;

    private bool _isLoadingMore;

    private string? _loadMoreError;

    private IJSObjectReference?
        _bffModule;

    private IJSObjectReference?
        _transactionStreamModule;

    private bool _useLocalTransactionFiltering;

    private bool _localTransactionFilterActivated;

    private List<BankTransactionViewModel>
        _transactions = [];

    private bool _isLoading =
        true;

    private bool _isRefreshing;

    private string? _errorMessage;

    private string _searchText =
        string.Empty;

    private string _selectedAccountId =
        string.Empty;

    private string? _accountFilterResetNotice;

    private TransactionLedgerPresentation.OutflowSummary _outflowSummary = new(null, 0);

    private string? _syncError;

    private int _pendingCount;

    private IReadOnlyList<
        TransactionAccountOption>
        _availableAccounts = [];

    private bool CanLoadMoreTransactions =>
        !_isLoadingMore &&
        _transactions.Count ==
            _transactionLoadLimit &&
        _transactionLoadLimit <
            MaximumTransactionLoadLimit;

    private string GetTransactionsResultLabel(
        int count)
    {
        return count == 1
            ? L["1 transaction"]
            : L["{0} transactions", count];
    }

    private IReadOnlyList<
        BankTransactionViewModel>
        FilteredTransactions =>
            _useLocalTransactionFiltering
                ? _transactions
                : _transactions
                    .Where(
                        MatchesSelectedAccount)
                    .Where(
                        MatchesSearch)
                    .ToList();

    protected override async Task
        OnAfterRenderAsync(
            bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();

            StateHasChanged();
            return;
        }

        if (!_useLocalTransactionFiltering ||
            _localTransactionFilterActivated ||
            _isLoading ||
            _transactions.Count == 0 ||
            _transactionStreamModule is null)
        {
            return;
        }

        try
        {
            _localTransactionFilterActivated =
                await _transactionStreamModule
                    .InvokeAsync<bool>(
                        "activateLocalTransactionFiltering",
                        "transaction-search-local",
                        "transaction-account-filter-local",
                        "transaction-result-count-local",
                        "transaction-local-empty");

            if (!_localTransactionFilterActivated)
            {
                _useLocalTransactionFiltering =
                    false;

                StateHasChanged();
            }
        }
        catch (JSException)
        {
            _useLocalTransactionFiltering =
                false;

            StateHasChanged();
        }
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
    }

    private async Task SyncNowAsync()
    {
        if (_isRefreshing ||
            _isLoadingMore)
        {
            return;
        }

        _isRefreshing =
            true;

        _syncError = null;

        StateHasChanged();

        try
        {
            _bffModule ??=
                await JS.InvokeAsync<
                    IJSObjectReference>(
                    "import",
                    "./js/bff.js");

            await _bffModule
                .InvokeAsync<object?>(
                    "refreshBillMonitoring");

            await LoadTransactionsCoreAsync();
        }
        catch (JSException)
        {
            _syncError = L["Sync failed. Your previously loaded transactions are still shown. Try syncing again."];
        }
        catch (Exception)
        {
            _syncError = L["Sync failed. Your previously loaded transactions are still shown. Try syncing again."];
        }
        finally
        {
            _isRefreshing =
                false;
        }
    }

    private async Task LoadAsync()
    {
        _isLoading =
            true;

        _errorMessage =
            null;

        _loadMoreError =
            null;
        _syncError = null;

        try
        {
            await EnsureInitialTransactionLoadLimitAsync();
            await LoadTransactionsCoreAsync();
        }
        catch (JSException)
        {
            _errorMessage =
                L["FullWorth could not reach the secure API."];
        }
        catch (Exception)
        {
            _errorMessage =
                L["Something went wrong while loading your transactions."];
        }
        finally
        {
            _isLoading =
                false;
        }
    }

    private async Task LoadMoreAsync()
    {
        if (!CanLoadMoreTransactions)
        {
            return;
        }

        var previousLimit =
            _transactionLoadLimit;

        _transactionLoadLimit =
            GetNextTransactionLoadLimit();

        _isLoadingMore =
            true;

        _loadMoreError =
            null;

        StateHasChanged();

        try
        {
            await LoadTransactionsCoreAsync();
        }
        catch (JSException)
        {
            _transactionLoadLimit =
                previousLimit;

            _loadMoreError =
                L["FullWorth could not load older transactions. Try again."];
        }
        catch (Exception)
        {
            _transactionLoadLimit =
                previousLimit;

            _loadMoreError =
                L["Something went wrong while loading older transactions."];
        }
        finally
        {
            _isLoadingMore =
                false;
        }
    }

    private async Task EnsureInitialTransactionLoadLimitAsync()
    {
        if (_hasResolvedInitialTransactionLoadLimit)
        {
            return;
        }

        // Performance profiling is optional. An unavailable or broken device
        // script must not block fetching the authenticated transaction ledger.
        const int fallbackLimit = 100;
        int requestedLimit = fallbackLimit;
        string executionMode = "server";

        try
        {
            requestedLimit = await JS.InvokeAsync<int>(
                "FullWorthPerformance.getTransactionLoadLimit");
            if (requestedLimit <= 0)
                requestedLimit = fallbackLimit;

            executionMode = await JS.InvokeAsync<string>(
                "FullWorthPerformance.getExecutionMode");
        }
        catch (JSException)
        {
            requestedLimit = fallbackLimit;
            executionMode = "server";
        }
        catch (Exception)
        {
            requestedLimit = fallbackLimit;
            executionMode = "server";
        }

        _transactionLoadLimit = Math.Clamp(
            requestedLimit, 50, MaximumTransactionLoadLimit);
        _useLocalTransactionFiltering = string.Equals(
            executionMode, "local", StringComparison.OrdinalIgnoreCase);
        _hasResolvedInitialTransactionLoadLimit = true;
    }

    private int GetNextTransactionLoadLimit()
    {
        return _transactionLoadLimit <
            ExpandedTransactionLoadLimit
                ? ExpandedTransactionLoadLimit
                : MaximumTransactionLoadLimit;
    }

    private async Task LoadTransactionsCoreAsync()
    {
        _bffModule ??=
            await JS.InvokeAsync<
                IJSObjectReference>(
                "import",
                "./js/bff.js");

        _transactionStreamModule ??=
            await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/transaction-stream.js");

        await using var streamReference =
            await _transactionStreamModule.InvokeAsync<IJSStreamReference>(
                "getBankTransactionsStream",
                _transactionLoadLimit);

        await using var stream =
            await streamReference.OpenReadStreamAsync(
                4 * 1024 * 1024);

        var result =
            await System.Text.Json.JsonSerializer.DeserializeAsync<
                BankTransactionViewModel[]>(
                stream,
                new System.Text.Json.JsonSerializerOptions(
                    System.Text.Json.JsonSerializerDefaults.Web));

        // A successful stream transport is not proof that financial rows
        // were decoded correctly. Null, duplicate/default IDs, missing account
        // identities and default dates must never replace a verified ledger.
        if (!IsValidLedgerSnapshot(result, _transactionLoadLimit))
        {
            throw new InvalidDataException(
                "The transaction response contained invalid records.");
        }

        _transactions = result!.ToList();

        _localTransactionFilterActivated =
            false;

        UpdateTransactionSummaries();
    }

    private static bool IsValidLedgerSnapshot(
        IReadOnlyList<BankTransactionViewModel>? rows, int requestedLimit)
    {
        if (rows is null || requestedLimit < 1 || rows.Count > requestedLimit ||
            rows.Any(row => row is null ||
                row.Id == Guid.Empty ||
                row.BankAccountId == Guid.Empty ||
                row.PostedDate == default))
        {
            return false;
        }

        return rows.Select(row => row.Id).Distinct().Count() == rows.Count;
    }

    private void UpdateTransactionSummaries()
    {
        _outflowSummary = TransactionLedgerPresentation.Summarize(
            _transactions.Select(transaction =>
                (transaction.Amount, transaction.IsoCurrencyCode, transaction.IsPending)));

        _pendingCount =
            _transactions.Count(
                transaction =>
                    transaction.IsPending);

        _availableAccounts =
            _transactions
                .GroupBy(
                    transaction =>
                        transaction.BankAccountId)
                .Select(
                    group =>
                    {
                        var transaction =
                            group.First();

                        return new
                            TransactionAccountOption(
                                transaction.BankAccountId,
                                transaction.InstitutionName,
                                transaction.AccountName,
                                transaction.AccountMask);
                    })
                .OrderBy(
                    account =>
                        account.InstitutionName)
                .ThenBy(
                    account =>
                        account.AccountName)
                .ToList();

        // A previously selected account may disappear after a successful
        // refresh; stale hidden filters must never hide current transactions.
        _accountFilterResetNotice = null;
        if (!string.IsNullOrWhiteSpace(_selectedAccountId) &&
            (!Guid.TryParse(_selectedAccountId, out var selectedId) ||
             !_availableAccounts.Any(account => account.Id == selectedId)))
        {
            _selectedAccountId = string.Empty;
            _accountFilterResetNotice =
                L["Previously selected account is not in the loaded history. Showing all loaded accounts."].Value;
        }
    }

    private bool MatchesSelectedAccount(
        BankTransactionViewModel transaction)
    {
        if (string.IsNullOrWhiteSpace(
                _selectedAccountId))
        {
            return true;
        }

        return Guid.TryParse(
                _selectedAccountId,
                out var accountId) &&
            transaction.BankAccountId ==
                accountId;
    }

    private bool MatchesSearch(
        BankTransactionViewModel transaction)
    {
        if (string.IsNullOrWhiteSpace(
                _searchText))
        {
            return true;
        }

        var search =
            _searchText.Trim();

        return Contains(
                transaction.Name,
                search) ||
            Contains(
                transaction.MerchantName,
                search) ||
            Contains(
                transaction.InstitutionName,
                search) ||
            Contains(
                transaction.AccountName,
                search) ||
            Contains(
                transaction.CategoryPrimary,
                search) ||
            Contains(
                transaction.CategoryDetailed,
                search);
    }

    private static bool Contains(
        string? value,
        string search)
    {
        return !string.IsNullOrWhiteSpace(
                value) &&
            value.Contains(
                search,
                StringComparison.OrdinalIgnoreCase);
    }

    private string GetTransactionName(
        BankTransactionViewModel transaction)
    {
        if (!string.IsNullOrWhiteSpace(
                transaction.MerchantName))
        {
            return transaction.MerchantName;
        }

        if (!string.IsNullOrWhiteSpace(
                transaction.Name))
        {
            return transaction.Name;
        }

        return L["Transaction"];
    }

    private static string GetAmountClass(
        decimal amount)
    {
        if (amount > 0m)
        {
            return
                "transaction-amount outflow";
        }

        if (amount < 0m)
        {
            return
                "transaction-amount credit";
        }

        return
            "transaction-amount";
    }

    private static string GetTransactionIconClass(
        decimal amount)
    {
        return amount < 0m
            ? "transaction-icon credit"
            : "transaction-icon outflow";
    }

    private static string GetTransactionIconText(
        decimal amount)
    {
        return amount < 0m
            ? "↓"
            : "↑";
    }

    private string FormatCategory(
        string value)
    {
        var display = value
            .Replace(
                "_",
                " ",
                StringComparison.Ordinal)
            .Trim();

        return L[display];
    }

    private static string GetAccountFilterLabel(
        TransactionAccountOption account)
    {
        var mask =
            string.IsNullOrWhiteSpace(
                account.Mask)
                ? string.Empty
                : $" · •••• {account.Mask}";

        return
            $"{account.InstitutionName} · {account.AccountName}{mask}";
    }

    public async ValueTask DisposeAsync()
    {
        if (_transactionStreamModule is not null)
        {
            try
            {
                await _transactionStreamModule
                    .InvokeVoidAsync(
                        "deactivateLocalTransactionFiltering");

                await _transactionStreamModule
                    .DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (_bffModule is not null)
        {
            try
            {
                await _bffModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private sealed record
        TransactionAccountOption(
            Guid Id,
            string InstitutionName,
            string AccountName,
            string? Mask);

    public sealed class
        BankTransactionViewModel
    {
        public Guid Id { get; set; }

        public Guid BankAccountId
        {
            get;
            set;
        }

        public string InstitutionName
        {
            get;
            set;
        } = string.Empty;

        public string AccountName
        {
            get;
            set;
        } = string.Empty;

        public string? AccountMask
        {
            get;
            set;
        }

        public string Name
        {
            get;
            set;
        } = string.Empty;

        public string? MerchantName
        {
            get;
            set;
        }

        public decimal Amount
        {
            get;
            set;
        }

        public string? IsoCurrencyCode
        {
            get;
            set;
        }

        public DateOnly PostedDate
        {
            get;
            set;
        }

        public DateOnly? AuthorizedDate
        {
            get;
            set;
        }

        public bool IsPending
        {
            get;
            set;
        }

        public string? CategoryPrimary
        {
            get;
            set;
        }

        public string? CategoryDetailed
        {
            get;
            set;
        }
    }
}
