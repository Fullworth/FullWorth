@page "/app/bills"

@using FullWorth.Web.Components.Shared
@using FullWorth.Core.Formatting
@using FullWorth.Web.Services

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@layout AppLayout

@implements IAsyncDisposable

@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<Bills> L

<PageTitle>@L["Bills — FullWorth"]</PageTitle>


<div class="app-page bills-page">
    <header class="page-heading bills-page-heading">
        <div>
            <span class="page-kicker">
                @L["Recurring commitments"]
            </span>

            <h1>
                @L["Bills"]
            </h1>

            <p>
                @L["Explore recurring charges, compare recent amounts, and open the evidence behind each bill."]
            </p>
        </div>
        @if (_hasSnapshot)
        {
            <button type="button" class="secondary-action bills-refresh"
                    disabled="@_isRefreshing" @onclick="ReloadAsync">
                @(_isRefreshing ? L["Refreshing…"] : L["Refresh bills"])
            </button>
        }
    </header>

    @if (!string.IsNullOrWhiteSpace(_refreshError))
    {
        <div class="bill-read-warning" role="status">@_refreshError</div>
    }
    @if (_hasSnapshot && _snapshot.TotalCount > 0)
    {
        <section class="bill-workspace-tools" aria-label="@L["Find bills"]">
            <div>
                <label for="bill-search">@L["Search bills"]</label>
                <input id="bill-search" type="search" maxlength="120" autocomplete="off"
                       @bind="_search" @bind:event="oninput" aria-describedby="bill-search-scope" />
            </div>
            <div>
                <label for="bill-currency">@L["Currency"]</label>
                <select id="bill-currency" @bind="_currency">
                    <option value="">@L["All currencies"]</option>
                    @foreach (var currency in Currencies)
                    {
                        <option value="@currency">@(currency == "?" ? L["Currency unavailable"].Value : currency)</option>
                    }
                </select>
            </div>
            <div>
                <label for="bill-sort">@L["Sort active bills"]</label>
                <select id="bill-sort" @bind="_sort">
                    <option value="@BillLedgerSort.Attention">@L["Changes and evidence gaps first"]</option>
                    <option value="@BillLedgerSort.Name">@L["Provider name"]</option>
                    <option value="@BillLedgerSort.LatestCharge">@L["Latest charge within currency"]</option>
                    <option value="@BillLedgerSort.Increase">@L["Change within currency"]</option>
                </select>
            </div>
            <button type="button" class="secondary-action" @onclick="ClearFilters">@L["Clear filters"]</button>
            <p id="bill-search-scope">@L["Search applies to all sections. Currency and change filters apply to active rows only. Summary totals do not change with filters."]</p>
        </section>
    }

    @if (_isLoading)
    {
        <div class="bill-card-grid">
            @for (var i = 0;
                  i < 6;
                  i++)
            {
                <div class="bill-card-skeleton"></div>
            }
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(
        _errorMessage))
    {
        <div class="app-error-state">
            <div class="state-symbol">
                <svg class="bw-sprite" aria-hidden="true">
                    <use href="/assets/billwatch-sprites.svg#alert"></use>
                </svg>
            </div>

            <div>
                <h2>
                    @L["We couldn't load your bills"]
                </h2>

                <p>
                    @_errorMessage
                </p>
            </div>

            <button type="button"
                    class="secondary-action"
                    @onclick="ReloadAsync">
                @L["Try again"]
            </button>
        </div>
    }
    else if (_billStreams.Count == 0)
    {
        @if (_snapshot.TotalCount == 0)
        {
            <BillsEmptyState />
        }
        else
        {
            <section class="app-panel bill-discovery-panel">
                <h2>@L["No active monitored bills"]</h2>
                <p>@L["Saved review and inactive bills remain available below. They are excluded from active totals."]</p>
            </section>
        }
    }
    else
    {
        var filteredBills =
            FilteredBills;

        <section class="fw-bills-pulse" aria-label="@L["Bill summary"]">
            <div class="fw-bills-total">
                <span>@L["Latest recognized charges"]</span>
                <strong>@(_snapshot.RecognizedTotal ?? L["Amount unavailable"].Value)</strong>
                <small>@L["Across {0} monitored recurring bills", _billStreams.Count]</small>
                @if (_snapshot.UnavailableCount > 0)
                {
                    <small>@L["Some bill amounts are unavailable and excluded from this total."]</small>
                }
                <small>@L["Active recognized charges only—not total spending or a normalized monthly budget."]</small>
                <small>@L["Usable amount and currency: {0} of {1} active bills.", _snapshot.KnownAmountCount, _billStreams.Count]</small>
            </div>

            <div class="fw-bills-stats">
                <button type="button"
                        class="@GetPulseFilterClass(BillLedgerFilter.Increased, "is-alert")"
                        aria-pressed="@(_filter == BillLedgerFilter.Increased)"
                        @onclick="() => SetFilter(BillLedgerFilter.Increased)">
                    <span>@L["Increased"]</span>
                    <strong>@_increasedCount</strong>
                    <small>@FormatIncreaseTotals() — @L["Compared charges only"]</small>
                </button>

                <button type="button"
                        class="@GetPulseFilterClass(BillLedgerFilter.Decreased, "is-positive")"
                        aria-pressed="@(_filter == BillLedgerFilter.Decreased)"
                        @onclick="() => SetFilter(BillLedgerFilter.Decreased)">
                    <span>@L["Decreased"]</span>
                    <strong>@_decreasedCount</strong>
                    <small>@L["Below prior averages"]</small>
                </button>

                <button type="button"
                        class="@GetPulseFilterClass(BillLedgerFilter.NoHistory, string.Empty)"
                        aria-pressed="@(_filter == BillLedgerFilter.NoHistory)"
                        @onclick="() => SetFilter(BillLedgerFilter.NoHistory)">
                    <span>@L["Building history"]</span>
                    <strong>@_noHistoryCount</strong>
                    <small>@L["Waiting for comparison evidence"]</small>
                </button>
            </div>
        </section>

        @if (_increasedCount > 0)
        {
            <section class="fw-bills-alert" aria-label="@L["Bills with increases"]">
                <div class="fw-bills-alert-icon" aria-hidden="true">
                    <svg class="bw-sprite">
                        <use href="/assets/billwatch-sprites.svg#trend-up"></use>
                    </svg>
                </div>

                <div class="fw-bills-alert-copy">
                    <span>@L["Worth a closer look"]</span>
                    <strong>
                        @L["{0} in current recurring increases", FormatIncreaseTotals()]
                    </strong>
                    <small>
                        @if (_snapshot.AnnualizedIncreaseTotal is not null)
                        {
                            @L["That is {0} annualized if these increases persist. Transaction amounts show what changed; provider evidence is still required to explain why.", _snapshot.AnnualizedIncreaseTotal]
                        }
                        else
                        {
                            @L["A yearly estimate is unavailable without supported monthly timing. Provider evidence is required to explain why a charge changed."]
                        }
                    </small>
                </div>

                <button type="button"
                        class="fw-bills-alert-action"
                        @onclick="() => SetFilter(BillLedgerFilter.Increased)">
                    <svg class="bw-sprite fw-bills-alert-action-icon"
                         aria-hidden="true">
                        <use href="/assets/billwatch-sprites.svg#trend-up"></use>
                    </svg>
                    <span>@L["Review increases"]</span>
                    <svg class="bw-sprite fw-bills-alert-action-arrow"
                         aria-hidden="true">
                        <use href="/assets/billwatch-sprites.svg#arrow-right"></use>
                    </svg>
                </button>
            </section>
        }

        <section class="fw-bills-ledger">
            <div class="fw-bills-ledger-head">
                <div>
                    <span class="panel-kicker">@L["Recurring bills"]</span>
                    <h2>@L["Bill ledger"]</h2>
                </div>

                <span aria-live="polite">
                    @L["Showing {0} of {1}", filteredBills.Count, _billStreams.Count]
                </span>
            </div>

            <div class="fw-bills-filters"
                 role="group"
                 aria-label="@L["Filter bills by change"]">
                <button type="button"
                        class="@GetFilterClass(BillLedgerFilter.All)"
                        aria-pressed="@(_filter == BillLedgerFilter.All)"
                        @onclick="() => SetFilter(BillLedgerFilter.All)">
                    @L["All"]
                    <span>@_billStreams.Count</span>
                </button>

                <button type="button"
                        class="@GetFilterClass(BillLedgerFilter.Increased)"
                        aria-pressed="@(_filter == BillLedgerFilter.Increased)"
                        @onclick="() => SetFilter(BillLedgerFilter.Increased)">
                    @L["Increased"]
                    <span>@_increasedCount</span>
                </button>

                <button type="button"
                        class="@GetFilterClass(BillLedgerFilter.Decreased)"
                        aria-pressed="@(_filter == BillLedgerFilter.Decreased)"
                        @onclick="() => SetFilter(BillLedgerFilter.Decreased)">
                    @L["Decreased"]
                    <span>@_decreasedCount</span>
                </button>

                <button type="button"
                        class="@GetFilterClass(BillLedgerFilter.NoHistory)"
                        aria-pressed="@(_filter == BillLedgerFilter.NoHistory)"
                        @onclick="() => SetFilter(BillLedgerFilter.NoHistory)">
                    @L["Building history"]
                    <span>@_noHistoryCount</span>
                </button>
            </div>

            <div class="fw-bills-filters bill-extra-filters" role="group" aria-label="@L["Additional bill filters"]">
                @foreach (var item in new[] { BillLedgerFilter.Unchanged, BillLedgerFilter.Unavailable })
                {
                    <button type="button" class="@GetFilterClass(item)"
                            aria-pressed="@(_filter == item)" @onclick="() => SetFilter(item)">
                        @(item == BillLedgerFilter.Unchanged ? L["No change"] : L["Amount unavailable"])
                        <span>@(item == BillLedgerFilter.Unchanged ? _snapshot.UnchangedCount : _snapshot.UnavailableCount)</span>
                    </button>
                }
            </div>
            <p class="bill-filter-scope">@L["Amount sorting groups currencies separately and performs no conversion. No-history and unavailable bills are not confirmed unchanged."]</p>

            @if (filteredBills.Count == 0)
            {
                <div class="filtered-empty">
                    <p>@L["No active bills match these filters. Saved review and inactive records are separate below."]</p>
                    <button type="button" class="secondary-action" @onclick="ClearFilters">@L["Clear filters"]</button>
                </div>
            }
            else
            {
                <div class="fw-bills-list">
                    @foreach (var bill in filteredBills)
                    {
                        var difference =
                            GetDifference(
                                bill);

                        <a @key="bill.Id" class="fw-bills-row"
                           href="@($"/app/bills/{bill.Id}")">
                            <div class="@GetBillAvatarClass(bill.Category)"
                                 aria-hidden="true">
                                <ProviderLogo ProviderName="@bill.ProviderName">
                                    <FallbackContent>
                                        <svg class="bw-sprite bill-category-sprite">
                                            <use href="@GetBillSpriteHref(bill.Category)"></use>
                                        </svg>
                                    </FallbackContent>
                                </ProviderLogo>
                            </div>

                            <div class="fw-bills-provider">
                                <strong>@bill.ProviderName</strong>
                                <span>@FormatCategory(bill.Category)</span>
                            </div>

                            <div class="fw-bills-current">
                                <span>@L["Current"]</span>
                                <strong>@(bill.HasTransactionEvidence ? FormatMoney(bill.CurrentAmount, bill.CurrencyCode) : L["Amount unavailable"].Value)</strong>
                            </div>

                            @if (BillLedgerSnapshot.CanCompare(bill))
                            {
                                <div class="@GetLedgerChangeClass(difference)">
                                    <span>@L["Change"]</span>
                                    <strong>@FormatDifference(difference, bill.CurrencyCode)</strong>
                                </div>

                                <div class="fw-bills-impact">
                                    <span>@(bill.HasMonthlyCadenceEvidence ? GetAnnualizedLabel(difference) : L["Yearly estimate unavailable"].Value)</span>
                                    <strong>@FormatAnnualized(bill, difference)</strong>
                                </div>
                            }
                            else
                            {
                                <div class="fw-bills-evidence">
                                    <span class="history-dot"></span>
                                    <span>@(BillLedgerSnapshot.HasAmount(bill) ? L["Building history"] : L["Comparison unavailable"])</span>
                                </div>
                            }

                            <span class="fw-row-chevron" aria-hidden="true">›</span>
                        </a>
                    }
                </div>
            }
        </section>
    }
    @if (_hasSnapshot && !_isLoading && _snapshot.Review.Count > 0)
    {
        <p class="bill-section-count" role="status">@L["Review matches: {0} of {1}", ReviewItems.Count, _snapshot.Review.Count]</p>
        @if (ReviewItems.Count > 0)
        {
            <BillReviewList Bills="ReviewItems" />
        }
        else
        {
            <p>@L["No review bills match your search. Clear the search to see saved records."]</p>
        }
    }
    @if (_hasSnapshot && !_isLoading && _snapshot.Inactive.Count > 0)
    {
        <details class="app-panel bill-inactive-history">
            <summary>@L["Inactive bill history ({0})", _snapshot.Inactive.Count]</summary>
            <p>@L["These saved bills are not actively monitored and do not contribute to active totals. Opening history does not reactivate a bill."]</p>
            <ul>
                @foreach (var bill in InactiveItems)
                {
                    <li @key="bill.Id"><a href="@($"/app/bills/{bill.Id:D}")">@bill.ProviderName — @L["Review bill"]</a></li>
                }
            </ul>
            @if (InactiveItems.Count == 0)
            {
                <p>@L["No inactive bills match your search."]</p>
            }
        </details>
    }

    <section class="app-panel bill-discovery-panel" aria-labelledby="discovery-heading">
        <h2 id="discovery-heading">@L["Missing a bill?"]</h2>
        <button type="button" class="secondary-action"
                aria-expanded="@_showDiscovery" aria-controls="discovery-details"
                @onclick="ToggleDiscoveryAsync">
            @(_showDiscovery ? L["Hide discovery details"] : L["Check discovery details"])
        </button>
        @if (_showDiscovery)
        {
            <div id="discovery-details" aria-busy="@_discoveryLoading">
                @if (_discoveryLoading)
                {
                    <p role="status">@L["Checking imported history…"]</p>
                }
                @if (_discoveryError)
                {
                    <p role="alert">@L["Discovery details could not be loaded. Try again."]</p>
                    @if (_discovery is not null)
                    {
                        <p>@L["Previously loaded discovery counts are shown and may be out of date."]</p>
                    }
                    <button type="button" class="secondary-action" disabled="@_discoveryLoading" @onclick="LoadDiscoveryAsync">@L["Try again"]</button>
                }
                @if (_discovery is not null)
                {
                    <button type="button" class="secondary-action" disabled="@_discoveryLoading" @onclick="LoadDiscoveryAsync">@L["Refresh discovery details"]</button>
                    <BillDiscoverySummary Data="_discovery" />
                }
            </div>
        }
    </section>
</div>

@code {
    private BillLedgerSnapshot _snapshot = BillLedgerSnapshot.Create([]);
    private IReadOnlyList<BillLedgerEntry> _billStreams => _snapshot.Active;
    private List<BillReviewList.Item> ReviewItems => _snapshot.Review
        .Where(bill => BillLedgerSnapshot.Matches(bill, _search))
        .Select(bill => new BillReviewList.Item(bill.Id, bill.ProviderName)).ToList();
    private IReadOnlyList<BillLedgerEntry> InactiveItems => _snapshot.Inactive
        .Where(bill => BillLedgerSnapshot.Matches(bill, _search)).ToArray();
    private string[] Currencies => _snapshot.Active.Select(BillLedgerSnapshot.CurrencyKey)
        .Distinct().OrderBy(value => value, StringComparer.Ordinal).ToArray();
    private IReadOnlyList<BillLedgerEntry> FilteredBills => _snapshot.Select(_search, _filter, _sort, _currency);
    private int _increasedCount => _snapshot.IncreasedCount;
    private int _decreasedCount => _snapshot.DecreasedCount;
    private int _noHistoryCount => _snapshot.NoHistoryCount;
    private BillLedgerFilter _filter = BillLedgerFilter.All;
    private BillLedgerSort _sort = BillLedgerSort.Attention;
    private string _search = string.Empty;
    private string _currency = string.Empty;
    private bool _hasSnapshot;
    private bool _isLoading = true;
    private bool _isRefreshing;
    private bool _disposed;
    private string? _errorMessage;
    private string? _refreshError;
    private IJSObjectReference? _bffModule;
    private BillDiscoverySummary.Snapshot? _discovery;
    private bool _showDiscovery;
    private bool _discoveryLoading;
    private bool _discoveryError;
    private long _discoveryVersion;

    private void ClearFilters()
    {
        _search = string.Empty;
        _currency = string.Empty;
        _filter = BillLedgerFilter.All;
        _sort = BillLedgerSort.Attention;
    }

    private async Task ToggleDiscoveryAsync()
    {
        _showDiscovery = !_showDiscovery;
        if (_showDiscovery) await LoadDiscoveryAsync();
        else
        {
            _discoveryVersion++;
            _discoveryLoading = false;
            _discovery = null;
        }
    }

    private async Task LoadDiscoveryAsync()
    {
        if (_discoveryLoading || _disposed || !_showDiscovery) return;
        var version = ++_discoveryVersion;
        _discoveryLoading = true;
        _discoveryError = false;
        try
        {
            _bffModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/bff.js");
            var data = await _bffModule.InvokeAsync<BillDiscoverySummary.Snapshot?>("getBillDiscoveryDiagnostics");
            if (_disposed || !_showDiscovery || version != _discoveryVersion) return;
            if (!ValidDiscovery(data)) throw new InvalidOperationException("Invalid discovery snapshot.");
            _discovery = data;
        }
        catch (Exception)
        {
            if (!_disposed && _showDiscovery && version == _discoveryVersion)
                _discoveryError = true;
        }
        finally
        {
            if (version == _discoveryVersion) _discoveryLoading = false;
        }
    }

    private static bool ValidDiscovery(BillDiscoverySummary.Snapshot? data) =>
        data is not null &&
        new[] { data.ImportedTransactions, data.ExcludedPendingOrNonDebitTransactions,
            data.ExcludedMissingMerchantTransactions, data.EligiblePostedTransactions,
            data.SingleObservationGroups, data.GroupsWithoutSupportedMonthlyCadence,
            data.DetectedMonthlyCandidates, data.RejectedCurrencyAmbiguity,
            data.RejectedExplicitFallbackCategories, data.RejectedInsufficientTwoObservationEvidence,
            data.RejectedOtherWeakOrVariableEvidence, data.AcceptedCandidates }.All(value => value >= 0) &&
        data.EligiblePostedTransactions <= data.ImportedTransactions &&
        data.AcceptedCandidates <= data.DetectedMonthlyCandidates &&
        (data.EligiblePostedTransactions == 0 ||
            (data.FirstEligiblePostedDate is not null && data.LastEligiblePostedDate is not null)) &&
        (data.FirstEligiblePostedDate is null || data.LastEligiblePostedDate is null ||
            data.FirstEligiblePostedDate <= data.LastEligiblePostedDate);

    protected override async Task
        OnAfterRenderAsync(
            bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadAsync();

        if (!_disposed) StateHasChanged();
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
    }

    private void SetFilter(
        BillLedgerFilter filter)
    {
        _filter =
            filter;
    }

    private string GetFilterClass(
        BillLedgerFilter filter)
    {
        return _filter == filter
            ? "bill-filter active"
            : "bill-filter";
    }

    private string GetPulseFilterClass(
        BillLedgerFilter filter,
        string stateClass)
    {
        var className =
            "fw-bills-stat";

        if (!string.IsNullOrWhiteSpace(
                stateClass))
        {
            className +=
                $" {stateClass}";
        }

        if (_filter == filter)
        {
            className +=
                " is-selected";
        }

        return className;
    }

    private async Task LoadAsync()
    {
        if (_isRefreshing || _disposed) return;
        _isRefreshing = true;
        _isLoading = !_hasSnapshot;
        _errorMessage = null;
        _refreshError = null;
        try
        {
            _bffModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/bff.js");
            var result = await _bffModule.InvokeAsync<BillStreamViewModel[]>("getBillStreams", true);
            if (result is null || result.Any(bill => bill is null))
                throw new InvalidOperationException("Bill snapshot unavailable.");
            var snapshot = BillLedgerSnapshot.Create(result.Select(bill => new BillLedgerEntry(
                bill.Id, bill.ProviderName, bill.Category, bill.IsActive, bill.Source,
                bill.HasTransactionEvidence, bill.HasMonthlyCadenceEvidence,
                bill.CurrentAmount, bill.PreviousAverage, bill.CurrencyCode)));
            if (_disposed) return;
            _snapshot = snapshot;
            _hasSnapshot = true;
            if (!Currencies.Contains(_currency, StringComparer.Ordinal)) _currency = string.Empty;
        }
        catch (Exception)
        {
            if (!_disposed)
            {
                if (_hasSnapshot)
                    _refreshError = L["Bills could not be refreshed. Previously loaded records are still shown and may be out of date. Refresh bills to retry."].Value;
                else
                    _errorMessage = L["FullWorth could not reach the secure API."].Value;
            }
        }
        finally
        {
            _isRefreshing = false;
            _isLoading = false;
        }
    }

    private static decimal GetDifference(BillLedgerEntry bill) => BillLedgerSnapshot.Difference(bill);

    private string FormatMoney(decimal amount, string? currencyCode) =>
        FinancialAmountFormatter.FormatOrUnspecified(amount, currencyCode, L["Currency unavailable"].Value);

    private string FormatTotals(IEnumerable<(decimal Amount, string? CurrencyCode)> amounts,
        decimal multiplier = 1m) =>
        FinancialAmountFormatter.FormatTotals(amounts, multiplier) ?? L["Amount unavailable"].Value;

    private string FormatIncreaseTotals() =>
        _snapshot.IncreaseTotal ?? L["Comparison unavailable"].Value;

    private string FormatDifference(
        decimal difference, string? currencyCode)
    {
        if (difference > 0m)
        {
            return $"+{FormatMoney(difference, currencyCode)}";
        }

        if (difference < 0m)
        {
            return $"-{FormatMoney(Math.Abs(difference), currencyCode)}";
        }

        return L["No change"].Value;
    }

    private string GetAnnualizedLabel(
        decimal difference)
    {
        return difference == 0m
            ? L["est. yearly cost"].Value
            : L["annualized impact"].Value;
    }

    private string FormatAnnualized(
        BillLedgerEntry bill,
        decimal difference)
    {
        if (!bill.HasMonthlyCadenceEvidence ||
            Math.Abs(difference == 0m ? bill.CurrentAmount : difference) > decimal.MaxValue / 12m ||
            !FinancialAmountFormatter.TryNormalizeCurrency(bill.CurrencyCode, out _))
        {
            return L["Not available"].Value;
        }

        if (difference == 0m)
        {
            var annualizedCost =
                decimal.Round(
                    Math.Max(
                        bill.CurrentAmount,
                        0m) *
                    12m,
                    2,
                    MidpointRounding.AwayFromZero);

            return
                $"{FormatMoney(annualizedCost, bill.CurrencyCode)}{L["/yr"].Value}";
        }

        var annualizedImpact =
            decimal.Round(
                difference * 12m,
                2,
                MidpointRounding.AwayFromZero);

        if (annualizedImpact > 0m)
        {
            return
                $"+{FormatMoney(annualizedImpact, bill.CurrencyCode)}{L["/yr"].Value}";
        }

        return
            $"-{FormatMoney(Math.Abs(annualizedImpact), bill.CurrencyCode)}{L["/yr"].Value}";
    }

    private static string GetLedgerChangeClass(
        decimal difference)
    {
        if (difference > 0m)
        {
            return "fw-bills-change is-increase";
        }

        if (difference < 0m)
        {
            return "fw-bills-change is-decrease";
        }

        return "fw-bills-change";
    }

    private static string GetChangePanelClass(
        decimal difference)
    {
        if (difference > 0m)
        {
            return "bill-change-panel increase";
        }

        if (difference < 0m)
        {
            return "bill-change-panel decrease";
        }

        return "bill-change-panel steady";
    }

    private static string GetBillAvatarClass(
        string category)
    {
        return category switch
        {
            "Internet" =>
                "bill-provider-avatar bill-category-internet",

            "MobilePhone" =>
                "bill-provider-avatar bill-category-phone",

            "Electricity" =>
                "bill-provider-avatar bill-category-electricity",

            "NaturalGas" =>
                "bill-provider-avatar bill-category-gas",

            "Utility" =>
                "bill-provider-avatar bill-category-utility",

            _ =>
                "bill-provider-avatar bill-category-other"
        };
    }

    private static string GetBillSpriteHref(
        string category)
    {
        var sprite =
            category switch
            {
                "Internet" =>
                    "internet",

                "MobilePhone" =>
                    "phone",

                "Electricity" =>
                    "electricity",

                "NaturalGas" =>
                    "gas",

                "Utility" =>
                    "utility",

                _ =>
                    "other-bill"
            };

        return
            $"/assets/billwatch-sprites.svg#{sprite}";
    }

    private string FormatCategory(
        string category)
    {
        if (string.IsNullOrWhiteSpace(
                category) ||
            string.Equals(
                category,
                "Unknown",
                StringComparison.OrdinalIgnoreCase))
        {
            return L["Recurring bill"].Value;
        }

        return category switch
        {
            "MobilePhone" =>
                L["Mobile phone"].Value,

            "NaturalGas" =>
                L["Natural gas"].Value,

            _ =>
                L[category].Value
        };
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _discoveryVersion++;
        _search = string.Empty;
        _discovery = null;
        _snapshot = BillLedgerSnapshot.Create([]);
        if (_bffModule is null)
        {
            return;
        }

        try
        {
            await _bffModule
                .DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public sealed class BillStreamViewModel
    {
        public Guid Id { get; set; }

        public string ProviderName
        {
            get;
            set;
        } = string.Empty;

        public string Category
        {
            get;
            set;
        } = string.Empty;

        public bool IsActive { get; set; }
        public string? CurrencyCode { get; set; }
        public string Source { get; set; } = "Unknown";
        public bool HasTransactionEvidence { get; set; }
        public bool HasMonthlyCadenceEvidence { get; set; }

        public decimal CurrentAmount
        {
            get;
            set;
        }

        public decimal PreviousAverage
        {
            get;
            set;
        }
    }
}
