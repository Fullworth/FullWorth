@page "/app/subscription"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@layout AppLayout
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<Subscription> L

<PageTitle>@L["Subscription — FullWorth"]</PageTitle>
<link rel="stylesheet" href="/subscription.css" />

<div class="app-page subscription-page">
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="subscription-toast @(_messageSucceeded ? "is-success" : "is-error")"
             role="@(_messageSucceeded ? "status" : "alert")">
            <span class="subscription-toast-icon">@(_messageSucceeded ? "✓" : "!")</span>
            <span>@_message</span>
            <button type="button" aria-label="@L["Dismiss notification"]" @onclick="DismissMessage">×</button>
        </div>
    }

    <header class="page-heading subscription-heading">
        <div>
            <span class="page-kicker">@L["FullWorth access"]</span>
            <h1>@L["Plan & access"]</h1>
            <p>@L["See how your FullWorth access is provided, manage billing when available, or redeem controlled beta access."]</p>
        </div>
    </header>

    @if (_loading)
    {
        <section class="subscription-card">
            <div class="subscription-loading">
                <span class="subscription-loading-ring" aria-hidden="true"></span>
                <div>
                    <strong>@L["Checking your access"]</strong>
                    <p>@L["FullWorth is verifying the subscription attached to this account."]</p>
                </div>
            </div>
        </section>
    }
    else if (_statusLoadFailed || _status is null)
    {
        <section class="subscription-card" data-subscription-read="status" role="alert">
            <h2>@L["Your access status could not be checked"]</h2>
            <p>@L["Your current access is unknown. Checking again does not redeem a key or start a payment."]</p>
            <button type="button" class="subscription-action secondary" disabled="@_reading" @onclick="RefreshAsync">@L["Retry access status"]</button>
        </section>
    }
    else
    {
        @if (_redemptionUncertain)
        {
            <section class="subscription-card" data-subscription-read="redemption" role="alert">
                <p>@L["The access-key result could not be confirmed. Check current access before trying another key or checkout."]</p>
                <button type="button" class="subscription-action secondary" disabled="@(_working || _reading)" @onclick="RefreshAsync">@L["Check current access"]</button>
            </section>
        }
        @if (_status?.IsActive == true)
        {
            <section class="subscription-card subscription-status-card fw-subscription-hero">
                <div class="subscription-card-heading">
                    <div class="subscription-card-icon active" aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#check"></use>
                        </svg>
                    </div>

                    <div>
                        <span class="subscription-state active">@L["Active"]</span>
                        <h2>@L["FullWorth access is active"]</h2>
                        <p>
                            @L["{0} access", _status.Tier ?? "FullWorth"]
                            @if (!string.IsNullOrWhiteSpace(_status.Source))
                            {
                                <text> · @_status.Source</text>
                            }
                        </p>
                    </div>
                </div>

                <div class="subscription-status-grid">
                    <div>
                        <span>@L["Access"]</span>
                        <strong>@(_status.IsPaid ? L["Paid subscription"] : L["Included access"])</strong>
                    </div>

                    <div>
                        <span>@L["Billing"]</span>
                        <strong>@FormatBillingInterval(_status.BillingInterval)</strong>
                    </div>

                    <div>
                        <span>@(_status.CancelAtPeriodEnd ? L["Access ends"] : L["Current period"])</span>
                        <strong>
                            @if (_status.EndsAtUtc is null)
                            {
                                <text>@L["Lifetime access"]</text>
                            }
                            else
                            {
                                <time datetime="@_status.EndsAtUtc.Value.ToString("O")">
                                    @FormatDate(_status.EndsAtUtc.Value)
                                </time>
                            }
                        </strong>
                    </div>
                </div>

                @if (_status.IsPaid && _status.CancelAtPeriodEnd)
                {
                    <div class="subscription-notice warning">
                        <strong>@L["Cancellation scheduled"]</strong>
                        <span>@L["Your paid plan will not renew after the current billing period."]</span>
                    </div>
                }

                <div class="subscription-actions-row">
                    <a class="subscription-action secondary" href="/app">
                        @L["Continue to FullWorth"]
                    </a>

                    @if (_status.IsPaid && _status.BillingAvailable)
                    {
                        <button class="subscription-action"
                                disabled="@(_working || _reading || _redemptionUncertain)"
                                @onclick="OpenBillingPortalAsync">
                            @(_operation == SubscriptionOperation.BillingPortal ? L["Opening…"] : L["Manage billing"])
                        </button>
                    }
                </div>
            </section>
        }

        @if (_status?.IsActive != true && _status?.BillingAvailable == true && _plans.Count == 0)
        {
            <section class="subscription-card" data-subscription-read="plans" role="@(_plansLoadFailed ? "alert" : "status")">
                <p>@(_plansLoadFailed ? L["FullWorth could not load paid plans. Your access status is still available."] : L["No paid plans are available right now."])</p>
                <button type="button" class="subscription-action secondary" disabled="@(_working || _plansLoading || _redemptionUncertain)" @onclick="LoadPlansAsync">@L["Retry paid plans"]</button>
            </section>
        }

        @if (_status?.IsActive != true && _status?.BillingAvailable == true && _plans.Count > 0)
        {
            <section class="subscription-pricing-section fw-subscription-pricing">
                <div class="subscription-section-heading">
                    <span class="page-kicker">@L["Simple pricing"]</span>
                    <h2>@L["Choose how you want to pay"]</h2>
                    <p>@L["Choose a billing interval. Review the final price and renewal terms in secure checkout before paying."]</p>
                </div>

                <div class="subscription-plan-grid">
                    @foreach (var plan in _plans.OrderBy(plan => plan.BillingInterval == "yearly" ? 1 : 0))
                    {
                        var isYearly = string.Equals(plan.BillingInterval, "yearly", StringComparison.OrdinalIgnoreCase);

                        <article class="subscription-plan-card fw-subscription-plan @(isYearly && YearlyOffersSavings ? "featured" : null)">
                            @if (isYearly && YearlyOffersSavings)
                            {
                                <span class="subscription-plan-badge">@L["Best value"]</span>
                            }

                            <div>
                                <span class="subscription-plan-label">
                                    @(isYearly ? L["Yearly"] : L["Monthly"])
                                </span>

                                <div class="subscription-plan-price">
                                    <strong>@FormatMoney(plan.UnitAmount, plan.Currency)</strong>
                                    <span>/ @(isYearly ? L["year"] : L["month"])</span>
                                </div>

                                @if (isYearly)
                                {
                                    <small>@L["About {0} per month when billed yearly", FormatMoney(plan.UnitAmount / 12, plan.Currency)]</small>
                                }
                                else
                                {
                                    <small>@L["Billed every month until you cancel"]</small>
                                }
                            </div>

                            <div class="subscription-feature-list">
                                <span>✓ @L["Recurring bill monitoring"]</span>
                                <span>✓ @L["Bill change detection"]</span>
                                <span>✓ @L["Monthly and annual impact"]</span>
                                <span>✓ @L["Statement-backed explanations when evidence is available"]</span>
                            </div>

                            <button class="subscription-action subscription-plan-action"
                                    disabled="@(_working || _reading || _redemptionUncertain)"
                                    @onclick="() => StartCheckoutAsync(plan.BillingInterval)">
                                @(_operation == SubscriptionOperation.Checkout ? L["Opening secure checkout…"] : L["Choose {0}", isYearly ? L["yearly"] : L["monthly"]])
                            </button>
                        </article>
                    }
                </div>

                <p class="subscription-legal-copy">
                    @L["Checkout is handled by our payment provider. By subscribing, you agree to the"]
                    <a href="/terms" target="_blank">@L["Terms of Service"]</a>
                    @L["and acknowledge the"]
                    <a href="/privacy" target="_blank">@L["Privacy Policy"]</a>.
                </p>
            </section>
        }
        else if (_status?.IsActive != true && _status?.BillingAvailable != true)
        {
            <section class="subscription-card fw-subscription-unavailable">
                <div class="subscription-card-heading">
                    <div class="subscription-card-icon" aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#subscription"></use>
                        </svg>
                    </div>
                    <div>
                        <span class="subscription-state">@L["Paid plans not configured"]</span>
                        <h2>@L["FullWorth paid checkout is not available yet"]</h2>
                        <p>@L["This environment is still using controlled beta access. No payment button is shown until real billing is configured."]</p>
                    </div>
                </div>
            </section>
        }

        @if (_status?.IsActive != true)
        {
            <section class="subscription-card subscription-access-key-card fw-subscription-beta">
                <div class="subscription-card-heading">
                    <div class="subscription-card-icon" aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#shield"></use>
                        </svg>
                    </div>
                    <div>
                        <span class="subscription-state">@L["Beta access"]</span>
                        <h2>@L["Have an access key?"]</h2>
                        <p>@L["Controlled beta and complimentary access keys can still be redeemed without entering payment information."]</p>
                    </div>
                </div>

                <form class="subscription-key-panel" @onsubmit="RedeemAsync" @onsubmit:preventDefault="true">
                    <label for="access-key">@L["Access key"]</label>

                    <div class="subscription-key-entry">
                        <input id="access-key"
                               @bind="_accessKey" @bind:event="oninput"
                               disabled="@(_working || _reading || _redemptionUncertain)"
                               autocomplete="off"
                               spellcheck="false"
                               placeholder="BW-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX" />

                        <button type="submit" class="subscription-action secondary"
                                disabled="@(_working || _reading || _redemptionUncertain)">
                            @(_operation == SubscriptionOperation.Redemption ? L["Activating…"] : L["Redeem key"])
                        </button>
                    </div>

                    <small>@L["Access keys are redeemed once and attached securely to your FullWorth account."]</small>
                </form>
            </section>
        }


    }
        <footer class="subscription-footer">
            <span>@L["Account export and deletion controls remain available regardless of subscription status."]</span>
            <div>
                <a href="/app/account/privacy">@L["Data controls"]</a>
                <a href="/terms">@L["Terms"]</a>
                <a href="/privacy">@L["Privacy"]</a>
            </div>
        </footer>
</div>

@code {
    private static readonly System.Globalization.CultureInfo UsCulture =
        System.Globalization.CultureInfo.GetCultureInfo("en-US");

    private IJSObjectReference? _module;
    private SubscriptionStatus? _status;
    private List<SubscriptionPlan> _plans = [];
    private string _accessKey = string.Empty;
    private string? _message;
    private bool _messageSucceeded;
    private bool _loading = true;
    private SubscriptionOperation _operation;
    private bool _working => _operation != SubscriptionOperation.None;
    private bool _reading, _plansLoading, _statusLoadFailed, _plansLoadFailed, _redemptionUncertain, _disposed;

    private bool YearlyOffersSavings
    {
        get
        {
            var monthly = _plans.FirstOrDefault(plan =>
                string.Equals(plan.BillingInterval, "monthly", StringComparison.OrdinalIgnoreCase));
            var yearly = _plans.FirstOrDefault(plan =>
                string.Equals(plan.BillingInterval, "yearly", StringComparison.OrdinalIgnoreCase));

            return monthly is not null &&
                   yearly is not null &&
                   string.Equals(monthly.Currency, yearly.Currency, StringComparison.OrdinalIgnoreCase) &&
                   yearly.UnitAmount < monthly.UnitAmount * 12m;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/subscription-bff.js");
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
            var checkout = query.TryGetValue("checkout", out var values) && values.Count == 1 ? values[0] : null;
            if (string.Equals(checkout, "success", StringComparison.OrdinalIgnoreCase))
            {
                try { await _module.InvokeAsync<object>("syncPaidSubscription"); }
                catch (JSException) { /* A fresh status read is authoritative, not the callback or sync response. */ }
                await ReadStatusAsync();
                if (!_disposed && !_statusLoadFailed)
                    SetMessage(_status is { IsActive: true, IsPaid: true }
                        ? L["Your paid FullWorth access is active."]
                        : L["Checkout returned, but paid access is not confirmed yet. Refresh this page shortly."],
                        succeeded: _status is { IsActive: true, IsPaid: true });
            }
            else
            {
                await ReadStatusAsync();
                if (string.Equals(checkout, "cancelled", StringComparison.OrdinalIgnoreCase))
                    SetMessage(L["Checkout was cancelled. You were not subscribed by FullWorth."], succeeded: false);
            }
        }
        catch (JSException)
        {
            if (!_disposed) _statusLoadFailed = true;
        }
        finally { _loading = false; if (!_disposed) StateHasChanged(); }
    }

    private Task RefreshAsync() => _working ? Task.CompletedTask : ReadStatusAsync();

    private async Task ReadStatusAsync()
    {
        if (_reading || _disposed) return;
        _reading = true;
        _loading = true;
        _statusLoadFailed = false;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/subscription-bff.js");
            var status = await _module.InvokeAsync<SubscriptionStatus>("getSubscription");
            if (status is null) throw new JSException("Invalid access status.");
            if (_disposed) return;
            _status = status;
            if (_redemptionUncertain)
            {
                _redemptionUncertain = false;
                SetMessage(status.IsActive ? L["Your FullWorth access is active."]
                    : L["Current access was checked. Review it before redeeming a key again."], status.IsActive);
            }
            if (status.BillingAvailable && !status.IsActive) await LoadPlansAsync();
            else { _plans.Clear(); _plansLoadFailed = false; }
        }
        catch (JSException)
        {
            if (!_disposed) _statusLoadFailed = true;
        }
        finally { _reading = false; _loading = false; if (!_disposed) StateHasChanged(); }
    }

    private async Task LoadPlansAsync()
    {
        if (_plansLoading || _disposed || _module is null || _status is not { BillingAvailable: true, IsActive: false }) return;
        _plansLoading = true;
        _plansLoadFailed = false;
        try
        {
            var plans = await _module.InvokeAsync<SubscriptionPlan[]>("getSubscriptionPlans");
            if (plans is null) throw new JSException("Invalid paid plan response.");
            if (!_disposed) _plans = plans.ToList();
        }
        catch (JSException)
        {
            if (!_disposed) { _plans.Clear(); _plansLoadFailed = true; }
        }
        finally { _plansLoading = false; if (!_disposed) StateHasChanged(); }
    }

    private async Task StartCheckoutAsync(string billingInterval)
    {
        if (_disposed || _working || _reading || _redemptionUncertain || _statusLoadFailed || _module is null ||
            _status is not { BillingAvailable: true, IsActive: false } ||
            !_plans.Any(plan => string.Equals(plan.BillingInterval, billingInterval, StringComparison.Ordinal))) return;
        _operation = SubscriptionOperation.Checkout;
        _message = null;
        try { await _module.InvokeVoidAsync("startCheckout", billingInterval); }
        catch (JSException)
        {
            if (!_disposed) SetMessage(L["FullWorth could not start secure checkout."], succeeded: false);
            _operation = SubscriptionOperation.None;
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task OpenBillingPortalAsync()
    {
        if (_disposed || _working || _reading || _redemptionUncertain || _statusLoadFailed || _module is null ||
            _status is not { IsActive: true, IsPaid: true, BillingAvailable: true }) return;
        _operation = SubscriptionOperation.BillingPortal;
        _message = null;
        try { await _module.InvokeVoidAsync("openBillingPortal"); }
        catch (JSException)
        {
            if (!_disposed) SetMessage(L["FullWorth could not open subscription management."], succeeded: false);
            _operation = SubscriptionOperation.None;
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task RedeemAsync()
    {
        if (_working || _reading || _redemptionUncertain || _statusLoadFailed || _disposed ||
            string.IsNullOrWhiteSpace(_accessKey) || _module is null || _status is not { IsActive: false }) return;
        _operation = SubscriptionOperation.Redemption;
        _message = null;
        var key = _accessKey.Trim();
        _accessKey = string.Empty;
        try
        {
            await _module.InvokeAsync<object>("redeemAccessKey", key);
            await ReadStatusAsync();
            if (_disposed) return;
            if (!_statusLoadFailed && _status?.IsActive == true)
                SetMessage(L["Your FullWorth access is active."], succeeded: true);
            else _redemptionUncertain = true;
        }
        catch (JSException)
        {
            if (!_disposed) _redemptionUncertain = true;
        }
        finally { _operation = SubscriptionOperation.None; if (!_disposed) StateHasChanged(); }
    }

    private void SetMessage(string message, bool succeeded)
    {
        _message = message;
        _messageSucceeded = succeeded;
    }

    private void DismissMessage()
    {
        _message = null;
    }

    private static string FormatDate(DateTimeOffset value) =>
        value.ToLocalTime().ToString("MMM d, yyyy", UsCulture);

    private string FormatBillingInterval(string? interval) =>
        interval?.ToLowerInvariant() switch
        {
            "monthly" => L["Monthly"],
            "yearly" => L["Yearly"],
            _ => L["Not applicable"]
        };

    private static string FormatMoney(long unitAmount, string? currency)
    {
        var amount = unitAmount / 100m;

        if (string.Equals(currency, "USD", StringComparison.OrdinalIgnoreCase))
        {
            return amount.ToString("C2", UsCulture);
        }

        return $"{amount:0.00} {currency?.ToUpperInvariant()}";
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _accessKey = string.Empty;
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private enum SubscriptionOperation { None, Checkout, BillingPortal, Redemption }

    private sealed class SubscriptionStatus
    {
        [System.Text.Json.Serialization.JsonRequired]
        public bool IsActive { get; set; }
        public string? Tier { get; set; }
        public DateTimeOffset? StartsAtUtc { get; set; }
        public DateTimeOffset? EndsAtUtc { get; set; }
        public string? Source { get; set; }
        [System.Text.Json.Serialization.JsonRequired]
        public bool BillingAvailable { get; set; }
        [System.Text.Json.Serialization.JsonRequired]
        public bool IsPaid { get; set; }
        public string? BillingInterval { get; set; }
        [System.Text.Json.Serialization.JsonRequired]
        public bool CancelAtPeriodEnd { get; set; }
        public string? ProviderStatus { get; set; }
    }

    private sealed class SubscriptionPlan
    {
        [System.Text.Json.Serialization.JsonRequired]
        public string BillingInterval { get; set; } = string.Empty;
        [System.Text.Json.Serialization.JsonRequired]
        public long UnitAmount { get; set; }
        [System.Text.Json.Serialization.JsonRequired]
        public string Currency { get; set; } = "USD";
    }
}
