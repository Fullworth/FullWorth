@page "/register"
@using FullWorth.Core.Legal

@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.Extensions.Localization.IStringLocalizer<FullWorth.Web.Components.App> L

<PageTitle>@L["Create account — FullWorth"]</PageTitle>

<link rel="stylesheet"
      href="/auth.css" />

<div class="auth-page">
    <div class="auth-glow auth-glow-one"></div>
    <div class="auth-glow auth-glow-two"></div>

    <div class="auth-shell">
        <a class="auth-brand"
           href="/">
            <span class="auth-brand-mark">
                <span></span>
            </span>

            <strong>
                FullWorth
            </strong>
        </a>

        <div class="auth-card">
            <div class="auth-heading">
                <span class="auth-kicker">
                    @L["Get started"]
                </span>

                <h1>
                    @(IsExternalRegistrationStep
                        ? $"{L["Finish creating your account with"].Value} {GetExternalProviderDisplayName()}"
                        : L["Create your account"])
                </h1>

                <p>
                    @(IsExternalRegistrationStep
                        ? L["Your provider verified your identity. Create a FullWorth password for sensitive account changes and recovery, then accept the current Terms and Privacy Notice."]
                        : L["One account for your FullWorth financial history."])
                </p>
            </div>

            @if (ExternalRegistrationError)
            {
                <div class="auth-error"
                     role="alert">
                    <span>!</span>
                    @L["FullWorth could not create that account through your sign-in provider. Try the provider again or create your account with email."]
                </div>
            }
            else if (ExternalRegistrationFormError)
            {
                <div class="auth-error"
                     role="alert">
                    <span>!</span>
                    @L["Check the password confirmation and accept the current Terms and Privacy Notice."]
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(
                Error))
            {
                <div class="auth-error"
                     role="alert">
                    <span>!</span>
                    @Error
                </div>
            }

            @if (IsExternalRegistrationStep)
            {
                <form method="post"
                      action="/auth/external/register/complete"
                      class="auth-form">

                    <AntiforgeryToken />

                    <input type="hidden"
                           name="provider"
                           value="@ConfiguredExternalRegistrationProvider" />

                    <input type="hidden"
                           name="legalTermsVersion"
                           value="@FullWorthLegalDocuments.CurrentVersion" />

                    <label class="field">
                        <span>@L["FullWorth password"]</span>

                        <input type="password"
                               name="password"
                               autocomplete="new-password"
                               placeholder="@L["Create a strong password"]"
                               minlength="12"
                               required />
                    </label>

                    <label class="field">
                        <span>@L["Confirm password"]</span>

                        <input type="password"
                               name="confirmPassword"
                               autocomplete="new-password"
                               placeholder="@L["Enter it again"]"
                               minlength="12"
                               required />
                    </label>

                    <div class="password-rules">
                        <strong>
                            @L["Password requirements"]
                        </strong>

                        <span>
                            @L["At least 12 characters"]
                        </span>

                        <span>
                            @L["Uppercase and lowercase letter"]
                        </span>

                        <span>
                            @L["Number and special character"]
                        </span>
                    </div>

                    <label class="legal-consent">
                        <input type="checkbox"
                               name="acceptedTermsAndPrivacy"
                               required />

                        <span>
                            @L["I agree to the"]
                            <a href="@FullWorthLegalDocuments.TermsPath"
                               target="_blank"
                               rel="noopener noreferrer">@L["Terms"]</a>
                            @L["and acknowledge the"]
                            <a href="@FullWorthLegalDocuments.PrivacyPath"
                               target="_blank"
                               rel="noopener noreferrer">@L["Privacy Notice"]</a>.
                        </span>
                    </label>

                    <button class="auth-submit"
                            type="submit">
                        @L["Create FullWorth account"]

                        <span aria-hidden="true">
                            →
                        </span>
                    </button>
                </form>

                <p class="auth-switch">
                    <a href="/register">
                        @L["Use a different sign-up method"]
                    </a>
                </p>
            }
            else
            {
                @if (HasExternalRegistration)
                {
                    <div class="external-signin-list"
                         aria-label="@L["External account creation options"]">

                        @if (GoogleRegistrationConfigured)
                        {
                            <a class="external-signin-button"
                               href="/auth/external/google/register">
                                <span class="external-provider-mark provider-google"
                                      aria-hidden="true">G</span>

                                <span>@L["Continue with Google"]</span>
                            </a>
                        }

                        @if (AppleRegistrationConfigured)
                        {
                            <a class="external-signin-button"
                               href="/auth/external/apple/register">
                                <span class="external-provider-mark provider-apple"
                                      aria-hidden="true">A</span>

                                <span>@L["Continue with Apple"]</span>
                            </a>
                        }
                    </div>

                    <div class="auth-choice-separator auth-provider-separator">
                        <span>@L["or create an account with email"]</span>
                    </div>
                }

                <form method="post"
                      action="/auth/register"
                      class="auth-form">

                    <AntiforgeryToken />

                    <input type="hidden"
                           name="legalTermsVersion"
                           value="@FullWorthLegalDocuments.CurrentVersion" />

                    <label class="field">
                        <span>@L["Email address"]</span>

                        <input type="email"
                               name="email"
                               autocomplete="email"
                               inputmode="email"
                               placeholder="you@example.com"
                               required />
                    </label>

                    <label class="field">
                        <span>@L["Password"]</span>

                        <input type="password"
                               name="password"
                               autocomplete="new-password"
                               placeholder="@L["Create a strong password"]"
                               minlength="12"
                               required />
                    </label>

                    <label class="field">
                        <span>@L["Confirm password"]</span>

                        <input type="password"
                               name="confirmPassword"
                               autocomplete="new-password"
                               placeholder="@L["Enter it again"]"
                               minlength="12"
                               required />
                    </label>

                    <div class="password-rules">
                        <strong>
                            @L["Password requirements"]
                        </strong>

                        <span>
                            @L["At least 12 characters"]
                        </span>

                        <span>
                            @L["Uppercase and lowercase letter"]
                        </span>

                        <span>
                            @L["Number and special character"]
                        </span>
                    </div>

                    <label class="legal-consent">
                        <input type="checkbox"
                               name="acceptedTermsAndPrivacy"
                               required />

                        <span>
                            @L["I agree to the"]
                            <a href="@FullWorthLegalDocuments.TermsPath"
                               target="_blank"
                               rel="noopener noreferrer">@L["Terms"]</a>
                            @L["and acknowledge the"]
                            <a href="@FullWorthLegalDocuments.PrivacyPath"
                               target="_blank"
                               rel="noopener noreferrer">@L["Privacy Notice"]</a>.
                        </span>
                    </label>

                    <button class="auth-submit"
                            type="submit">
                        @L["Create account"]

                        <span aria-hidden="true">
                            →
                        </span>
                    </button>
                </form>
            }

            <p class="privacy-note">
                @L["FullWorth accounts are used to keep financial records isolated to their owner."]
            </p>

            <div class="auth-divider">
                <span></span>
            </div>

            <p class="auth-switch">
                @L["Already have an account?"]

                <a href="/login">
                    @L["Sign in"]
                </a>
            </p>
        </div>

        <a class="back-home"
           href="/">
            ← @L["Back to FullWorth"]
        </a>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(
        Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(
        Name = "externalRegistration")]
    public bool ExternalRegistration { get; set; }

    [SupplyParameterFromQuery(
        Name = "externalRegistrationError")]
    public bool ExternalRegistrationError { get; set; }

    [SupplyParameterFromQuery(
        Name = "externalRegistrationFormError")]
    public bool ExternalRegistrationFormError { get; set; }

    [SupplyParameterFromQuery(
        Name = "provider")]
    public string? Provider { get; set; }

    private bool GoogleRegistrationConfigured =>
        IsExternalProviderConfigured(
            "Google");

    private bool AppleRegistrationConfigured =>
        IsExternalProviderConfigured(
            "Apple");

    private bool HasExternalRegistration =>
        GoogleRegistrationConfigured ||
        AppleRegistrationConfigured;

    private string? ConfiguredExternalRegistrationProvider =>
        Provider?.Trim().ToLowerInvariant() switch
        {
            "google" when GoogleRegistrationConfigured =>
                "google",

            "apple" when AppleRegistrationConfigured =>
                "apple",

            _ =>
                null
        };

    private bool IsExternalRegistrationStep =>
        ExternalRegistration &&
        ConfiguredExternalRegistrationProvider is not null;

    private string GetExternalProviderDisplayName()
    {
        return ConfiguredExternalRegistrationProvider switch
        {
            "google" =>
                "Google",

            "apple" =>
                "Apple",

            _ =>
                L["your sign-in provider"].Value
        };
    }

    private bool IsExternalProviderConfigured(
        string provider)
    {
        var clientId =
            Configuration[
                $"ExternalIdentity:{provider}:ClientId"];

        var clientSecret =
            Configuration[
                $"ExternalIdentity:{provider}:ClientSecret"];

        return !string.IsNullOrWhiteSpace(
                   clientId) &&
               !string.IsNullOrWhiteSpace(
                   clientSecret);
    }
}
