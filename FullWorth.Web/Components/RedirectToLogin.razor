@inject NavigationManager Navigation

@code {
    protected override void OnAfterRender(
        bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        Navigation.NavigateTo(
            "/login?ReturnUrl=" + Uri.EscapeDataString(FullWorth.Web.Services.LocalLoginDestination.Normalize(
                "/" + Navigation.ToBaseRelativePath(Navigation.Uri))),
            forceLoad: true);
    }
}