# Copy to .env.ai outside source control, replace every placeholder, chmod 600,
# then validate it before starting the isolated evaluation runtime:
#
#   sh deploy/validate-ai-evaluation-env.sh .env.ai
#   sh deploy/verify-approved-ai-model.sh full .env.ai
#   docker compose --env-file .env.ai --file compose.ai-evaluation.yml up
#
# The model server is published only on host loopback (127.0.0.1:8080) and its
# container network is internal, so it has no ordinary internet egress.

# Approved CPU-safe evaluation runtime. Changing this tag or digest requires a
# reviewed runtime-manifest update and exact-head CI.
FULLWORTH_LOCAL_AI_IMAGE=ghcr.io/ggml-org/llama.cpp:server-b11176@sha256:6257697a7f5d034b8fb499ddb07af3e250506352f94102054252a23f3b85e0af

# First approved evaluation artifact:
# Qwen/Qwen3-4B-GGUF @ a9a60d009fa7ff9606305047c2bf77ac25dbec49
# Qwen3-4B-Q4_K_M.gguf, 2,497,280,256 bytes, Apache-2.0.
# The committed verifier rejects a different hash or file size.
FULLWORTH_LOCAL_AI_MODEL_PATH=/absolute/path/to/Qwen3-4B-Q4_K_M.gguf
FULLWORTH_LOCAL_AI_MODEL_SHA256=7485fe6f11af29433bc51cab58009521f205840f5b4ae3a32fa7f92e8534fdf5

# Separate randomly generated credential used only between FullWorth and
# llama.cpp. Do not reuse any FullWorth, Plaid, database, or provider secret.
FULLWORTH_LOCAL_AI_API_KEY=replace-with-at-least-32-random-characters

# The API's StatementAi:Local:Model value must match this alias.
FULLWORTH_LOCAL_AI_MODEL_ALIAS=fullworth-local

# Conservative evaluation defaults. Increase only from measured evidence.
FULLWORTH_LOCAL_AI_CONTEXT_SIZE=8192
FULLWORTH_LOCAL_AI_MAX_PREDICT=4096
FULLWORTH_LOCAL_AI_THREADS=4

# CPU-only default. A GPU-enabled runtime requires a separately reviewed
# host/container device configuration before raising this value.
FULLWORTH_LOCAL_AI_GPU_LAYERS=0
