# syntax=docker/dockerfile:1

# Digest-pinned Microsoft images keep the reviewed base immutable while retaining
# the version tag for human-readable upgrade diffs.
FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:478b9038d187e5b5c29bfa8173ded5d29e864b5ad06102a12106380ee01e2e49 AS build

WORKDIR /src

COPY FullWorth.Core/FullWorth.Core.csproj FullWorth.Core/
COPY FullWorth.Web/FullWorth.Web.csproj FullWorth.Web/
RUN dotnet restore FullWorth.Web/FullWorth.Web.csproj

COPY FullWorth.Core/ FullWorth.Core/
COPY FullWorth.Web/ FullWorth.Web/

RUN dotnet publish FullWorth.Web/FullWorth.Web.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:a04d1c1d2d26119049494057d80ea6cda25bbd8aef7c444a1fc1ef874fd3955b AS final

ARG BILLWATCH_RELEASE_ID=unknown

LABEL org.opencontainers.image.revision="$BILLWATCH_RELEASE_ID"

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /app/publish/ ./

RUN mkdir --parents /var/lib/billwatch-web/keys \
    && chown --recursive "$APP_UID:$APP_UID" /var/lib/billwatch-web
